# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Backup artefacts created by install.ps1 / uninstall.ps1
.pre-mmtoolbox-backup-*
*.bak

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Local-only overrides (a user can add machine-local rules here without committing)
local/
*.local

# session-restore runtime state: the log and the generated per-project boot scripts.
# Machine-specific and regenerated on every run - never committed.
tools/session-restore/.state/

# session-restore selection registry: which directories reopen at logon, on THIS
# machine. It lives beside the scripts (one place, nothing scattered) but the paths
# in it are local, so it is never committed.
tools/session-restore/sessions-registry.json
tools/session-restore/sessions-registry.json.tmp

# session-restore application wrapper: BUILD OUTPUT, not source. Sessions.exe is
# compiled from tools/session-restore/app/SessionsHost.cs by app/build.ps1, which
# the installer runs. The .ico beside it is drawn by the same script. Both are
# reproducible from what IS committed, so neither belongs in git -- and a stale
# committed binary is worse than none, because it would launch instead of the
# source everyone can read.
tools/session-restore/Sessions.exe
tools/session-restore/app/sessions.ico

# Python bytecode (the automate-lane-* skills ship .py scripts)
__pycache__/
*.pyc
