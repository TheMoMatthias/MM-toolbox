<Project>

  <!--
    Settings every project in the rebuild shares.

    🔴 WARNINGS ARE ERRORS FROM THE FIRST COMMIT, and that is the point of doing
    it now rather than "once it settles". The whole case for leaving PowerShell
    was the defect classes a compiler rejects - an unassigned local holding the
    previous iteration's value, a null flowing somewhere that cannot take one, a
    culture-sensitive compare. A build that tolerates warnings throws that away
    quietly, and by the time anyone turns it on there are four hundred of them
    and it gets turned off again.

    🪤 NULLABLE IS THE ONE THAT PAYS FOR ITSELF HERE. The PowerShell reads a
    registry, a config and a transcript that are all allowed to be missing,
    half-written or from an older version, and every one of those paths is
    currently a $null that flows until something downstream notices.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

  <!--
    🔴 InvariantGlobalization WAS SET HERE AND HAS BEEN REMOVED, and the reason
    is worth keeping. It was set to make the default string comparison ordinal,
    because `("· x").StartsWith("⏵")` returned True under the current culture and
    cost a day. But it is the wrong instrument: it makes CurrentCulture invariant
    for EVERYTHING, including display - so a hook duration this operator's
    PowerShell renders as "3,8s" on his German machine came out as "3.8s". The
    rebuild's oracle caught it at $.rows[479].head80.

    🔑 COMPARISONS ARE ORDINAL BECAUSE THEY SAY SO, NOT BECAUSE THE CULTURE IS
    GONE. Every comparison in this solution passes StringComparison explicitly,
    and CA1307/CA1310 are errors here, so the compiler refuses one that does not.
    That leaves real cultures available for the one thing they are for: showing
    a number to the person whose machine it is.
  -->

  <PropertyGroup>
    <Product>session-restore</Product>
    <Company>MM-toolbox</Company>
    <Copyright>Personal tool. No warranty.</Copyright>
  </PropertyGroup>

</Project>
