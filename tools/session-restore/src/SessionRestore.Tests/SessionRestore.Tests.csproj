<Project Sdk="Microsoft.NET.Sdk">

  <!--
    xUnit against Core. No window, no splice, no clash guard.

    The parity checklist these work through is rebuild/04-BEHAVIOUR.md - 2.269
    assertions extracted from the PowerShell suites, which are the only complete
    statement of what this tool is supposed to do.
  -->

  <PropertyGroup>
    <RootNamespace>SessionRestore.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      CA1707 forbids underscores in member names. That rule is aimed at a public
      API surface; here the members are test names, and Some_thing_it_must_do
      reads as the sentence it is meant to be while SomeThingItMustDo does not.
      The suppression is scoped to THIS project - warnings stay errors
      everywhere, and this is the one place the convention is deliberate.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SessionRestore.Core\SessionRestore.Core.csproj" />
    <ProjectReference Include="..\SessionRestore.Oracle\SessionRestore.Oracle.csproj" />
  </ItemGroup>

</Project>
