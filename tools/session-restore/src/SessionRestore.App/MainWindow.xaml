<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SessionRestore.App.MainWindow"
        Title="Claude sessions (rebuild scaffold)"
        Width="720" Height="360"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        Background="#08080A">
  <!--
    UseLayoutRounding, TextFormattingMode=Display and TextRenderingMode=Grayscale
    are carried over deliberately rather than left at their defaults. The
    knowledge ledger records why: ClearType is subpixel antialiasing and made the
    type look coloured at the edges on this ground, and Ideal formatting made it
    look hand-drawn on a grid. They were chosen by looking at rendered text.
  -->
  <StackPanel Margin="28" VerticalAlignment="Center">
    <TextBlock Text="session-restore" Foreground="#F2F3F5" FontSize="26" FontWeight="SemiBold"/>
    <TextBlock Text="the C# rebuild - scaffold only, phase 1 of rebuild/00-PLAN.md"
               Foreground="#8A8F98" FontSize="13" Margin="0,4,0,18"/>
    <TextBlock x:Name="RootLine" Foreground="#6B6F76" FontSize="12" TextWrapping="Wrap"/>
    <TextBlock x:Name="StateLine" Foreground="#6B6F76" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
</Window>
