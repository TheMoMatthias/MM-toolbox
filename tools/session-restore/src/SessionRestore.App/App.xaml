<!--
  🔴 x:Class IS WHAT CONNECTS App.xaml.cs AT ALL. Without it the SDK's
  generated entry point builds a plain System.Windows.Application, the `App`
  class in App.xaml.cs is never instantiated, and OnStartup never runs - which
  presents as a process that starts, sits at 37 MB doing nothing, and writes not
  one line of its own trace. It was missing from the Phase 1 scaffold and cost
  three wrong diagnoses before the trace was moved to the first line of
  OnStartup and STILL printed nothing.
-->
<Application x:Class="SessionRestore.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Application.Resources>
    <!--
      The real resource dictionary is lib\window2.xaml - 169 KB, 66 styles and
      templates, tuned against rendered pixels. It is ported at plan item 4.1
      and NOT before: a scaffold that starts inventing styles is a scaffold that
      has to be un-invented later.
    -->
  </Application.Resources>
</Application>
