<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Claude sessions"
        Width="1480" Height="980" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        Background="#08080A">

  <!-- 🔴 WHY THE TEXT LOOKED "PROGRAMMATIC".
       Three settings, and two of them were fighting the fonts:

         TextRenderingMode was ClearType. ClearType is SUBPIXEL antialiasing -
         it tints the edge of every stem red or blue to buy horizontal
         resolution. On white it disappears; on a #0F1013 ground it is visible
         colour fringing on every glyph, and that fringe is what reads as a
         utility program rather than a designed surface. Grayscale antialiasing
         is what modern dark UI uses, and what a phone renders.

         SnapsToDevicePixels forced glyph edges onto whole pixels, which is
         right for a 1px border and wrong for letterforms: it is what makes type
         look hand-drawn on a grid. UseLayoutRounding stays, so the hairlines
         are still crisp; the text is no longer nailed to the grid.

         TextFormattingMode stays Ideal - Display mode snaps advance widths and
         throws away the optical spacing Segoe UI Variable exists to provide.
       ================================================== -->

  <!-- ================== THE FRAME ==================
       NO OS TITLE BAR, but still a real window.

       🔴 WindowChrome, NOT WindowStyle=None. WindowStyle="None" alone throws
       away the frame AND everything the frame did: Aero Snap, edge resize,
       maximise-to-work-area, and the drop shadow. WindowChrome removes only the
       painted caption and lets Windows keep managing the rest, so dragging to
       an edge still snaps and the borders still resize.

       🔴 CaptionHeight IS THE HEADER PLUS THE INSET (46 + 14 = 60). The app is
       a card floating 14px inside the window, so the header no longer starts at
       the window's top edge - and the ground around the card should drag it too,
       which the same number gives for free.

       🔴 CaptionHeight MATCHES THE HEADER, and that is what makes this behave
       like a window. It was 0, which told Windows "there is no caption here" -
       so the only way to move the window was the app calling DragMove itself,
       and with it you lose everything Windows does with a caption: drag, snap to
       an edge, aero-shake, Win+arrow, double-click to maximise, and the system
       menu on right-click or Alt+Space. The window could be maximised and closed
       (those are our own buttons) but NOT MOVED, which is exactly what was
       reported.

       Every interactive control sitting in that strip opts back OUT with
       WindowChrome.IsHitTestVisibleInChrome="True" - without it Windows treats
       the click as a caption drag and the control never sees it. Anything on the
       strip WITHOUT that attribute is draggable surface, which is why the title
       text is not marked.

       GlassFrameThickness="0" keeps the DWM glass out of a dark window;
       UseAeroCaptionButtons="False" stops Windows drawing its own.
       ============================================== -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="60"
                        ResizeBorderThickness="6"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>

    <!-- ================== PALETTE ==================
         Colour is allowed here for the first time, and it carries exactly one
         meaning: WHAT A CONVERSATION NEEDS FROM YOU. Every accent is twinned
         with a glyph and a band heading, so the screen still reads correctly in
         a screenshot, on a monochrome display, or to somebody who cannot tell
         these hues apart. Colour is the fast path; it is never the only path.
         ============================================ -->
    <!-- 🔴 THERE IS NO HUE IN THIS WINDOW, AND THAT IS THE WHOLE IDEA.
         Colour used to mean four things at once - needs you, focus, primary,
         danger - so it meant none of them. White is now the only emphasis there
         is, and it is spent in exactly two ways, which do not compete because
         they are different KINDS of thing:
           as a STATE   white type and a lit edge, and only a conversation
                        waiting on you earns it
           as a SURFACE a filled white control - the one action a panel is for
         Everything else is a step down the grey ladder. That is why a single lit
         card reads across the room.

         The ladder is the LUMINANCE ladder: on a near-black ground, shadow does
         nothing and only lightness separates one surface from another. The steps
         are ~8 points, where the old palette's four surfaces sat within six
         points of EACH OTHER and read as one flat plane. -->
    <SolidColorBrush x:Key="Ink"       Color="#08080A"/>   <!-- L0 the ground, around the window -->
    <SolidColorBrush x:Key="Panel"     Color="#0F0F11"/>   <!-- L1 the window itself -->
    <SolidColorBrush x:Key="PanelHi"   Color="#16161A"/>   <!-- L2 a raised surface -->
    <SolidColorBrush x:Key="Rail"      Color="#0D0D0F"/>   <!-- L1- the sunken rail -->
    <SolidColorBrush x:Key="Sheet"     Color="#1B1B20"/>   <!-- L3 sheets and dialogs -->
    <SolidColorBrush x:Key="Hairline"  Color="#24242A"/>
    <SolidColorBrush x:Key="HairSoft"  Color="#191920"/>

    <SolidColorBrush x:Key="TextMax"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextHigh"  Color="#E4E6EB"/>
    <SolidColorBrush x:Key="TextMid"   Color="#9A9DA6"/>
    <SolidColorBrush x:Key="TextLow"   Color="#6C6F78"/>

    <!-- The bands. They are LUMINANCE STEPS, not colours: needs-you is pure
         white and everything else recedes from it. The band heading, the row's
         edge bar and the unread dot all take these, so a band still reads
         without colour vision, in a screenshot, and in greyscale print. -->
    <SolidColorBrush x:Key="AccNeeds"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccWorking" Color="#9EA2AC"/>
    <SolidColorBrush x:Key="AccDone"    Color="#71757E"/>
    <SolidColorBrush x:Key="AccIdle"    Color="#54575E"/>
    <SolidColorBrush x:Key="AccQuiet"   Color="#3A3D43"/>
    <!-- Focus is a neutral ring. It used to be the same clay as needs-you, so
         the keyboard's position and a demand for your attention were the same
         signal. -->
    <SolidColorBrush x:Key="Focus"      Color="#8E939D"/>

    <!-- ================== THE HUES ==================
         The monochrome rule above is AMENDED, not abandoned. Hue now carries
         exactly two things - WHO SPOKE and WHICH PROJECT - and nothing else.
         State stays a luminance step, so a band still reads in greyscale, in a
         screenshot and without colour vision; losing hue costs you the speaker
         label's colour and nothing that decides what needs attention.

         🪤 These do NOT compete with the band accents, because they never
         appear in the same place: bands live in the rail and the list, hues
         live inside the reading pane and on the project tiles.
         ============================================== -->
    <SolidColorBrush x:Key="HueIn"    Color="#7AA2FF"/>   <!-- came in  - claude speaking -->
    <SolidColorBrush x:Key="HueOut"   Color="#FFB86B"/>   <!-- went out - you speaking -->
    <SolidColorBrush x:Key="HueTool"  Color="#A78BFA"/>   <!-- the machinery between them -->
    <SolidColorBrush x:Key="HueBad"   Color="#FF7A8A"/>   <!-- a call that failed -->
    <SolidColorBrush x:Key="HueAsk"   Color="#5EEAD4"/>   <!-- a question waiting on you -->
    <SolidColorBrush x:Key="HueWarn"  Color="#FFD166"/>

    <SolidColorBrush x:Key="HueAskWash"  Color="#5EEAD4" Opacity="0.10"/>
    <SolidColorBrush x:Key="HueAskFilm"  Color="#5EEAD4" Opacity="0.05"/>
    <SolidColorBrush x:Key="HueAskEdge"  Color="#5EEAD4" Opacity="0.34"/>

    <!-- The bevel: a dark outer stroke with a light inner highlight, so a
         surface looks lit from above rather than outlined. One pair, used by
         every raised thing in the window. -->
    <SolidColorBrush x:Key="BevelDark"  Color="#000000" Opacity="0.45"/>
    <SolidColorBrush x:Key="BevelLit"   Color="#FFFFFF" Opacity="0.09"/>
    <SolidColorBrush x:Key="EdgeLit"    Color="#FFFFFF" Opacity="0.14"/>
    <SolidColorBrush x:Key="GlassLo"    Color="#FFFFFF" Opacity="0.035"/>
    <SolidColorBrush x:Key="GlassMid"   Color="#FFFFFF" Opacity="0.055"/>
    <SolidColorBrush x:Key="GlassHi"    Color="#FFFFFF" Opacity="0.075"/>

    <SolidColorBrush x:Key="SelBg"     Color="#232329"/>
    <SolidColorBrush x:Key="HoverBg"   Color="#17171C"/>

    <!-- ================== TYPE ==================
         SEGOE UI VARIABLE, AND WHY IT IS THREE FAMILIES.
         It is Windows 11's own optically-sized family and the direct counterpart
         to SF Pro and Roboto - which is what "make it look like Apple or Google"
         actually means on this platform. Optical sizing means the letterforms
         are DRAWN differently per size rather than scaled: Small has open
         spacing and sturdy strokes so 11px captions stay legible, Display is
         tightly spaced so headings do not look gappy. Using one face at every
         size is precisely what made this window read as utilitarian.

           Small    <= 12px   captions, overlines, meta
           Text     13-17px   everything you read
           Display  >= 18px   the window title and headings

         Each falls back to plain Segoe UI, so a machine without the variable
         family degrades to what this file used before rather than to Arial.

         🔴 EVERY REFERENCE TO THESE FOUR KEYS IS A DynamicResource, AND THAT IS
         NOT A STYLE PREFERENCE. Install-SRTypeface swaps the shipped Manrope in
         by REPLACING these entries at runtime, after this file has been parsed.
         A {StaticResource FontText} inside a Setter is resolved while the
         dictionary is being built, so it captures the FontFamily object that is
         here NOW and never looks at the key again: the swap then changed the
         key and not one single Style, and the whole window carried on rendering
         Segoe. It looked convincing from a screenshot, and the font test passed,
         because the test asked the KEY what it resolved to rather than asking a
         Style what it was drawn with - and the transcript, which resolves its
         face in script after the swap, really was on Manrope. DynamicResource
         keeps the reference live, so replacing the entry reaches all 15 styles.
         The gui2 suite now asserts this from a realised TextBlock.
         ========================================== -->
    <FontFamily x:Key="FontSmall">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <!-- There is no FontUi alias any more. It existed as a bridge during the
         rebuild and became the way two styles quietly stayed off the scale -
         the buttons and the surface switch were still at 12px while everything
         else moved to 13.5. Three families, one scale, no aliases. -->

    <!-- 🔴 THE WINDOW'S OWN DEFAULT, so anything built in CODE inherits it too.
         The option buttons under a question, the cast rows and the manager menu
         are all created in PowerShell with no style of their own; without this
         they fall back to WPF's default, which is 12px Segoe UI - the one thing
         on screen that would still look like a different application. -->
    <Style TargetType="{x:Type Window}">
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
    <!-- ================== RIGHT-CLICK, AND HINTS ==================
         🔴 SETTING THE FONT ON THESE WAS NEVER ENOUGH. A ContextMenu with no
         TEMPLATE keeps the operating system's own chrome: a white slab with a
         blue highlight and a 3D border, thrown up in the middle of a black
         window the moment you right-click a session. Same for ToolTip - a pale
         yellow-white box with a hairline. They are the last two surfaces in the
         tool still drawn by Windows rather than by this file, and they are
         reached constantly. Templated here, on the same tokens as everything
         else, so the design holds all the way through.
         ============================================================ -->
    <Style TargetType="{x:Type ContextMenu}">
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
      <Setter Property="Padding" Value="0,6,0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Border x:Name="shell" Background="{StaticResource Sheet}" CornerRadius="10"
                    BorderBrush="{StaticResource EdgeLit}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}" MinWidth="210"
                    SnapsToDevicePixels="True">
              <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.62" Color="#000000"/>
              </Border.Effect>
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}">
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type MenuItem}">
            <Border x:Name="b" Background="Transparent" CornerRadius="7"
                    Margin="6,1,6,1" Padding="12,8,12,8" SnapsToDevicePixels="True">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource SelBg}"/>
                <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
              </Trigger>
              <!-- A separator is written as a header-less item in the script; it
                   must not look like something you can press. -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TextLow}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Separator}">
            <Border Height="1" Margin="12,5,12,5" Background="{StaticResource Hairline}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToolTip}">
            <Border Background="{StaticResource Sheet}" CornerRadius="8"
                    BorderBrush="{StaticResource EdgeLit}" BorderThickness="1"
                    Padding="11,7,11,8" MaxWidth="380" SnapsToDevicePixels="True">
              <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
              </Border.Effect>
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ONE SCALE, and every size in the window comes from it. The old file had
         fourteen inline FontSize values between 10.5 and 12.5, which is not a
         scale, it is fourteen decisions. -->
    <Style x:Key="Display" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource FontDisplay}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
    </Style>
    <!-- An overline, not a heading: small, spaced out, quiet. The letter spacing
         is what stops an all-caps run reading as shouting. -->
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource FontSmall}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextLow}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
    </Style>
    <Style x:Key="Dim" TargetType="TextBlock" BasedOn="{StaticResource Body}">
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style x:Key="Meta" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource FontSmall}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource TextLow}"/>
    </Style>

    <!-- ================== SCROLLBAR ==================
         Thin, dark, and out of the way. A default WPF scrollbar is the single
         loudest thing on a dark surface. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" Margin="2,0,2,0" Background="#33383F"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== DROPDOWN ==================
         WPF's stock ComboBox is Windows-95 grey with a 3D bevel, which on a dark
         surface is the loudest thing on the screen. Retemplated to match the
         buttons; the popup is retemplated too, or the LIST stays grey even when
         the box does not. -->
    <Style x:Key="DropItem" TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,7,10,7"/>
      <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource SelBg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Drop" TargetType="ComboBox">
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource DropItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bb" CornerRadius="7" Background="{StaticResource Ink}"
                            BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Margin="11,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="10" Foreground="{StaticResource TextLow}"
                                   VerticalAlignment="Center" Margin="8,0,11,0"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bb" Property="BorderBrush" Value="{StaticResource TextLow}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                Margin="11,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                <Border Background="{StaticResource PanelHi}" CornerRadius="8" Margin="0,4,0,0"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="280">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                  </Border.Effect>
                  <ScrollViewer><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== CHECKBOX ==================
         A filled square, matching the manager's tick: one shape for "this is on"
         everywhere in the window. -->
    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border Width="15" Height="15" CornerRadius="3" VerticalAlignment="Center"
                      BorderBrush="#3A3F47" BorderThickness="1.4" Margin="0,0,9,0">
                <Border x:Name="fill" Background="{StaticResource TextMax}" CornerRadius="1.5"
                        Margin="2" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="fill" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== CAPTION BUTTONS ==================
         46x46 hit targets, flush to the top-right corner with no margin, so the
         maximised window keeps the Fitts's-law corner the OS gave up. Segoe MDL2
         Assets is the shell's own icon font and is present on every Windows 10
         and 11 machine. -->
    <Style x:Key="CaptionBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#23262C"/>
                <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionBtnClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== BUTTONS ================== -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
      <Setter Property="Padding" Value="11,6,11,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="{StaticResource PanelHi}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#23262C"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- An answer to a question, not a control on a toolbar. It is a full-width
         row carrying a label and the reasoning under it, so it needs a taller
         ground, a left alignment and room for two lines of type - and it sits
         INSIDE the question panel, so its ground is a step up from that panel
         rather than the window's raised surface. -->
    <Style x:Key="BtnOption" TargetType="Button">
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
      <Setter Property="Padding" Value="15,11,15,12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="11" Background="{StaticResource GlassMid}"
                    BorderBrush="Transparent" BorderThickness="1"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource GlassHi}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource HueAskEdge}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource HueAsk}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="#141518"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="{StaticResource AccNeeds}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The surface switch. Two segments, and the CHECKED one is filled: the
         two surfaces differ by shape, so the switch has to say plainly which
         shape you are looking at. -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="Padding" Value="13,6,13,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="5" Background="Transparent"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource SelBg}"/>
                <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/>
                <Setter TargetName="b" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== SEARCH BOX ================== -->
    <Style x:Key="Search" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{DynamicResource FontText}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccNeeds}"/>
      <Setter Property="Padding" Value="12,0,12,0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="8" Background="{StaticResource Ink}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1">
              <Grid>
                <!-- THE PLACEHOLDER. An empty rounded rectangle says nothing
                     about what it is for; the search box read as decoration.
                     🔴 THE TEXT COMES FROM THE BOX'S OWN Tag, never from this
                     style: the composer uses this same style, and a hard-coded
                     string put "Search conversations..." inside the box you type
                     replies into. Shown only while empty, and not hit-testable so
                     it can never eat a click meant for the field beneath. -->
                <TextBlock x:Name="ph"
                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                           FontFamily="{DynamicResource FontText}" FontSize="14"
                           Foreground="{StaticResource TextLow}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="12,0,12,0"
                           Visibility="Collapsed"/>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== LIST BASE ==================
         Virtualizing and recycling on purpose: the sessions column can hold
         every conversation in the registry, and a ListBox that realises 214
         two-line rows is a visible stall on every rebuild. -->
    <Style x:Key="Plain" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained"/>
    </Style>

    <Style x:Key="PlainItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBg}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource SelBg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- ================== THE SESSION ROW ==================
         TWO LINES, because the one thing that makes this list scannable is what
         each conversation last SAID, and a 336px column cannot hold that on the
         same line as a name. Line one is identity and age; line two is the last
         thing it said, ellipsised.

         The band accent appears as a 3px bar down the left of a row and as a dot
         beside the name - never as the only signal. The band HEADING above it
         says the same thing in words, so the grouping survives without colour.

         Visibility is a property ON THE ROW OBJECT rather than a converter:
         PowerShell can set System.Windows.Visibility directly and it binds with
         no extra type in the way.
         ==================================================== -->
    <DataTemplate x:Key="SessionRowTpl">
      <Grid>
        <!-- the band heading -->
        <Border Visibility="{Binding BandVis}" Padding="12,10,12,8" Margin="6,8,6,0"
                CornerRadius="8" Background="{Binding BandBg}" Cursor="Hand"
                ToolTip="Show only these - click again for all of them">
          <StackPanel Orientation="Horizontal">
            <Border Width="3" Height="13" CornerRadius="2" Background="{Binding Accent}"
                    VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock Text="{Binding BandLabel}" Style="{StaticResource Caption}"
                       Foreground="{Binding Accent}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding BandCount}" Style="{StaticResource Caption}"
                       FontWeight="Normal" Margin="9,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding BandHint}" Style="{StaticResource Meta}"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- a conversation -->
        <Border Visibility="{Binding RowVis}" Padding="0,10,14,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{Binding Accent}" Opacity="{Binding BarOpacity}"/>
            <StackPanel Grid.Column="1" Margin="15,0,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding Accent}"
                         Visibility="{Binding DotVis}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}"
                           FontWeight="{Binding NameWeight}" FontStyle="{Binding NameStyle}"
                           Foreground="{StaticResource TextMax}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Age}" Style="{StaticResource Meta}"
                           Margin="9,0,0,0" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{Binding Said}" Style="{StaticResource Dim}"
                         TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <!-- The rail row: a project, its conversation count, and whether it is the
         one currently filtering. It FILTERS - it is never the grouping. -->
    <!-- ================== A PROJECT TILE ==================
         This was a one-line text row - a name and a number - and at 29
         projects it read as a directory listing rather than as the place you
         choose where to look next. A tile has room for the thing that actually
         decides that: what is happening INSIDE the project. "13" is the same
         number whether all 13 are asleep or one is waiting on you.

         🔴 THE ONLY HUE IN THE WINDOW IS THE 3px BAR, and that is the whole
         concession. Grey carries STATE, hue carries IDENTITY, and they never
         swap jobs: the bar says WHICH project, the greys say how it is doing.
         A tinted surface would put the accent in competition with the white
         that means NEEDS YOU, which is the one thing in this window that must
         never have to compete for attention.
         ================================================== -->
    <DataTemplate x:Key="RailRowTpl">
      <Border Margin="8,3,8,3" CornerRadius="8" Background="{Binding PickBg}"
              BorderBrush="{Binding PickEdge}" BorderThickness="1"
              Padding="0,8,11,9" SnapsToDevicePixels="True">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- the identity mark -->
          <Border Grid.Column="0" Grid.RowSpan="2" Width="4" CornerRadius="2"
                  Margin="10,2,12,2" Background="{Binding Accent}"
                  Opacity="{Binding AccentOpacity}"/>

          <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Label}"
                     Style="{StaticResource Body}" Foreground="{Binding Fg}"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <!-- The dot repeats what the word says, for the one state worth
               finding without reading: a project with something waiting. -->
          <Border Grid.Column="2" Grid.Row="0" Width="6" Height="6" CornerRadius="3"
                  VerticalAlignment="Center" Margin="8,0,0,0"
                  Visibility="{Binding NeedsVis}"
                  Background="{StaticResource AccNeeds}"/>
          <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                     Text="{Binding State}" Style="{StaticResource Meta}"
                     Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>
    </DataTemplate>


    <!-- ================== THE MANAGER ROW ==================
         A FULL WIDTH TABLE, and that is the point: the session manager differs
         from the work surface by SHAPE, so the two can never be mistaken for one
         another - in a screenshot, on a monochrome screen, or by a reader who
         cannot tell the accents apart.

         The LOGON tick is the first column and fenced off by a rule, because it
         is the one control on this screen that decides tomorrow morning. It is a
         checkbox and it never launches anything.
         ===================================================== -->
    <DataTemplate x:Key="ManageRowTpl">
      <Grid>
        <!-- a project header -->
        <Border Visibility="{Binding ProjVis}" Padding="0,12,20,10" Background="{StaticResource Panel}"
                Cursor="Hand">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Caret}" Style="{StaticResource Meta}"
                       HorizontalAlignment="Right" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Body}"
                       FontWeight="SemiBold" Foreground="{StaticResource TextMax}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="{Binding Meta}" Style="{StaticResource Meta}"/>
          </Grid>
        </Border>

        <!-- a conversation -->
        <Border Visibility="{Binding ConvVis}" Padding="0,8,20,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Named so the click handler can tell "clicked the box" from
                 "clicked the row". A wider transparent hit area than the 15px
                 mark, because a checkbox you have to aim at is a checkbox that
                 reads as broken. -->
            <Border Grid.Column="0" x:Name="TickBox" Background="Transparent" Cursor="Hand"
                    ToolTip="Click to tick - a ticked conversation reopens at your next logon">
              <Border Width="15" Height="15" CornerRadius="3" HorizontalAlignment="Center"
                      VerticalAlignment="Center" BorderBrush="#3A3F47" BorderThickness="1.4"
                      Background="{Binding TickBg}"/>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}"
                       FontStyle="{Binding NameStyle}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="14,0,10,0"/>
            <TextBlock Grid.Column="2" Text="{Binding Lane}" Style="{StaticResource Meta}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="3" Text="{Binding Said}" Style="{StaticResource Dim}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="4" Text="{Binding Age}" Style="{StaticResource Meta}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

  </Window.Resources>

  <!-- =========================================================================
       THE SHELL — an INSET CARD, not a maximised rectangle.
       The window's own background is the ground; the app is a rounded card
       floating on it with the ground visible around every edge. That gap is the
       single change that makes this read as a designed object rather than a
       window that happens to be dark, and it costs 14px per side.

       Four rows inside it: title bar, surface switch, the body, status.
       The BODY is where the two surfaces differ:
         work surface    tiles | sessions | output pane
         session manager one full-width table
       Only one of the two is ever visible.

       🪤 THE CARD IS CLIPPED, so its rounded corners actually cut the content.
       Without the clip the corners are painted but children square them off
       again, which looks like a rendering bug rather than a radius.
       ========================================================================= -->
  <Border x:Name="Shell" Margin="14" CornerRadius="18" Background="{StaticResource Panel}"
          BorderBrush="{StaticResource EdgeLit}" BorderThickness="1"
          SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="46" ShadowDepth="14" Opacity="0.62" Color="#000000"/>
    </Border.Effect>
    <Border.Clip>
      <RectangleGeometry x:Name="ShellClip" RadiusX="17" RadiusY="17" Rect="0,0,1452,952"/>
    </Border.Clip>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ========== 0. title - the app's OWN caption ==========
         This strip IS the title bar. Dragging it moves the window (DragMove,
         wired in the script); double-clicking it maximises. Everything
         interactive on it carries IsHitTestVisibleInChrome so the chrome does
         not eat the click first. -->
    <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="20,0,0,0"
            Height="46">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Claude sessions" Style="{StaticResource Display}" VerticalAlignment="Center"/>
          <TextBlock x:Name="LiveCount" Style="{StaticResource Dim}" Margin="16,1,0,0"
                     VerticalAlignment="Center" Text=""/>
        </StackPanel>
        <TextBox x:Name="Search" Grid.Column="1" Style="{StaticResource Search}"
                 Tag="Search conversations, projects, worktrees"
                 MaxWidth="560" MinWidth="380" HorizontalAlignment="Center"
                 shell:WindowChrome.IsHitTestVisibleInChrome="True"
                 ToolTip="Find by title, id, worktree or project. Press / from anywhere."/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,10,0">
          <TextBlock x:Name="Stamp" Style="{StaticResource Meta}" Margin="0,0,14,0" VerticalAlignment="Center"/>
          <Button x:Name="NewSession" Content="New session" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"
                  ToolTip="Start a fresh conversation (Ctrl+N)"/>
          <Button x:Name="Rescan" Content="Rescan" Style="{StaticResource Btn}"/>
        </StackPanel>

        <!-- The window buttons. Close goes red on hover the way every Windows
             app does; the other two lighten. Symbols are Segoe MDL2 glyphs, the
             same ones the OS caption uses, so they read as window controls
             rather than as letters. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Stretch"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="WinMin" Style="{StaticResource CaptionBtn}" Content="&#xE921;"
                  ToolTip="Minimise" AutomationProperties.Name="Minimise"/>
          <Button x:Name="WinMax" Style="{StaticResource CaptionBtn}" Content="&#xE922;"
                  ToolTip="Maximise" AutomationProperties.Name="Maximise"/>
          <Button x:Name="WinClose" Style="{StaticResource CaptionBtnClose}" Content="&#xE8BB;"
                  ToolTip="Close" AutomationProperties.Name="Close"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========== 1. which surface ========== -->
    <Border Grid.Row="1" Background="{StaticResource Ink}"
            BorderBrush="{StaticResource HairSoft}" BorderThickness="0,0,0,1" Padding="18,9,18,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="7"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="3">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ModeWork" Style="{StaticResource Seg}" Content="Work surface" IsChecked="True"
                         ToolTip="What is happening now: every conversation that is running or was, grouped by what it needs from you."/>
            <RadioButton x:Name="ModeManage" Style="{StaticResource Seg}" Content="Session manager"
                         ToolTip="What comes back at logon: every conversation by project, with the tick that decides."/>
          </StackPanel>
        </Border>
        <!-- Column 1 is deliberately empty. It carried a row of band chips that
             was never populated: the band headings inside the list already show
             every count, and duplicating them in the chrome was the thing the
             redesign set out to remove. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Broadcast" Content="Send to many" Style="{StaticResource Btn}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========== 2. the body ========== -->
    <Grid Grid.Row="2">

      <!-- ===== WORK SURFACE: rail | sessions | output pane =====
           The splitters are real, and their widths are remembered. The rail and
           the sessions column collapse on narrow windows: see Set-Breakpoint in
           the script. Three columns is not a luxury that vanishes when the
           window is small, it is a layout with a defined behaviour at every
           width. -->
      <!-- 🔴 THE PANES ARE CARDS ON A GROUND, not regions divided by hairlines.
           They were flat rectangles separated by 1px rules, which is what the
           operator meant by "the rounded edges and backgrounds are all gone" -
           only the OUTER shell had ever been given the treatment the canvas
           showed. Each pane now has its own radius, its own edge and its own
           shadow, and the gutters between them are the ground showing through.
           That is the whole difference between a window that reads as layered
           and one that reads as partitioned. -->
      <Grid x:Name="WorkSurface" Background="{StaticResource Ink}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="RailCol" Width="248" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition x:Name="ListCol" Width="372" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- the projects rail: a FILTER, never the grouping -->
        <Border x:Name="RailPane" Grid.Column="0" Background="{StaticResource Panel}"
                CornerRadius="12" Margin="10,4,3,10" SnapsToDevicePixels="True"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1">
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.42" Color="#000000"/>
          </Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 🔴 THE PANE SEARCHES, SORTS AND FILTERS ITSELF. The header box
                 is the GLOBAL one and reaches both panes at once; that is not
                 the same as narrowing this list while leaving the other alone,
                 which is what the operator asked for twice. -->
            <StackPanel Grid.Row="0">
              <Border Padding="16,12,12,6">
                <Grid>
                  <TextBlock Text="PROJECTS" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="RailClear" Text="clear" Style="{StaticResource Dim}"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             Cursor="Hand" Visibility="Collapsed"
                             ToolTip="Stop filtering by project."/>
                </Grid>
              </Border>
              <TextBox x:Name="RailSearch" Style="{StaticResource Search}"
                       Margin="12,0,12,7" Tag="Find a project"
                       AutomationProperties.Name="find a project"/>
              <Border Padding="14,0,12,9">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="RailSort" Style="{StaticResource Meta}" Cursor="Hand"
                             VerticalAlignment="Center"
                             ToolTip="Change how the projects are ordered"/>
                  <TextBlock Text="  ·  " Style="{StaticResource Meta}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="RailOnlyLive" Style="{StaticResource Meta}" Cursor="Hand"
                             VerticalAlignment="Center"
                             ToolTip="Show only projects with something running"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <ListBox x:Name="RailList" Grid.Row="1" Style="{StaticResource Plain}"
                     ItemContainerStyle="{StaticResource PlainItem}"
                     ItemTemplate="{StaticResource RailRowTpl}"
                     AutomationProperties.Name="projects"/>
          </Grid>
        </Border>

        <GridSplitter x:Name="RailSplit" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- the sessions column: grouped by BAND, two lines per row -->
        <Border x:Name="ListPane" Grid.Column="2" Background="{StaticResource Panel}"
                CornerRadius="12" Margin="3,4,3,10" SnapsToDevicePixels="True"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1">
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.42" Color="#000000"/>
          </Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="16,12,12,6">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="ListCaption" Text="SESSIONS" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                  <!-- The order inside each band. A label rather than a dropdown:
                       there are three of them and cycling is one click. -->
                  <TextBlock x:Name="ListSort" Style="{StaticResource Meta}" Cursor="Hand"
                             VerticalAlignment="Center" Margin="12,0,0,0"
                             ToolTip="Change the order inside each band"/>
                </StackPanel>
                <TextBlock x:Name="ListCount" Style="{StaticResource Dim}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <!-- This pane's own search, independent of the header's global one. -->
            <TextBox x:Name="ListSearch" Grid.Row="1" Style="{StaticResource Search}"
                     Margin="12,0,12,8" Tag="Find a conversation"
                     AutomationProperties.Name="find a conversation"/>
            <ListBox x:Name="SessionList" Grid.Row="2" Style="{StaticResource Plain}"
                     ItemContainerStyle="{StaticResource PlainItem}"
                     ItemTemplate="{StaticResource SessionRowTpl}"
                     AutomationProperties.Name="sessions"/>
          </Grid>
        </Border>

        <GridSplitter x:Name="ListSplit" Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- the output pane: header, transcript, pinned question, composer -->
        <Border x:Name="OutputPane" Grid.Column="4" Background="{StaticResource Panel}"
                CornerRadius="12" Margin="3,4,10,10" SnapsToDevicePixels="True"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1">
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.42" Color="#000000"/>
          </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="18,12,18,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="PaneName" Style="{StaticResource H1}" Text="" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <Border x:Name="PaneStateDot" Width="7" Height="7" CornerRadius="4"
                          Background="{StaticResource AccIdle}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <TextBlock x:Name="PaneState" Style="{StaticResource Dim}" Text=""/>
                </StackPanel>
                <!-- ================== THE VITALS ==================
                     What the terminal's own status line shows, for the session
                     you are looking at: which model, how much context it has
                     spent, the branch, the working tree against HEAD, whether
                     Remote Control is on, and what is running right now.

                     Every figure is already on disk - `message.model` and
                     `message.usage` on an assistant record, `gitBranch` on
                     every record, a Task or background Bash whose result has
                     not come back - so none of it costs a question to claude.
                     Only the +N -N asks git, and that answer is cached.
                     ================================================ -->
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                <Button x:Name="PaneTools" Content="Steps: folded" Style="{StaticResource Btn}" Margin="0,0,8,0"
                        ToolTip="How much of the machinery this pane shows - folded, full, or hidden. Remembered."/>
                <Button x:Name="PaneWorktree" Content="New on worktree" Style="{StaticResource Btn}" Margin="0,0,8,0"
                        ToolTip="Start a fresh conversation in another worktree of this project"/>
                <Button x:Name="PaneSettings" Content="Settings" Style="{StaticResource Btn}" Margin="0,0,8,0"
                        ToolTip="Name, model, effort, permissions, Remote Control, hidden"/>
                <Button x:Name="PaneGoTo" Content="Go to terminal" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
                <Button x:Name="PaneRelaunch" Content="Relaunch" Style="{StaticResource Btn}"/>
              </StackPanel>
              <!-- 🪤 ITS OWN ROW, SPANNING BOTH COLUMNS. Inside the left column
                   it only ever got the width the five buttons left over, so on
                   a live session it wrapped onto two lines and the strip read
                   as a stack rather than as a status line. Across the full
                   header it is one line, which is what makes it scannable. -->
              <WrapPanel x:Name="PaneChips" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,11,0,0"/>
            </Grid>
          </Border>

          <!-- ================== THE CONTROL PLANE ==================
               🔴 EVERY FIELD HERE IS A LAUNCH FLAG. claude reads them once, at
               startup, so nothing changed here reaches a session that is already
               running until it is reopened. The panel says so out loud and the
               Apply button offers the relaunch - a dropdown that silently did
               nothing would be worse than no dropdown.
               ====================================================== -->
          <!-- ================== SEND TO MANY ==================
               One line into several conversations at once. It is the thing a
               twenty-session day actually needs, and it is also the most
               dangerous button in the window - so it names every conversation
               it will type into, and it will not touch one that is mid-turn.
               ================================================== -->
          <Border x:Name="CastBox" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="20"
                  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,18,0"
                  Width="470" Background="{StaticResource PanelHi}" CornerRadius="10"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="18,16,18,16">
            <Border.Effect>
              <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="SEND TO MANY" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
              <TextBlock x:Name="CastWho" Style="{StaticResource Meta}" TextWrapping="Wrap"
                         Margin="0,0,0,10" Text=""/>
              <ListBox x:Name="CastList" Style="{StaticResource Plain}" MaxHeight="240"
                       ItemContainerStyle="{StaticResource PlainItem}" Margin="0,0,0,12">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="0,5,0,5" Cursor="Hand">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="CastTick" Width="15" Height="15" CornerRadius="3"
                                VerticalAlignment="Center" BorderBrush="#3A3F47" BorderThickness="1.4"
                                Background="{Binding TickBg}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Body}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Why}" Style="{StaticResource Meta}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBox x:Name="CastText" Style="{StaticResource Search}"
                       Tag="The one line every ticked conversation will receive" Margin="0,0,0,12"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CastCancel" Content="Cancel" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
                <Button x:Name="CastSend" Content="Send" Style="{StaticResource BtnPrimary}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 🪤 ROW 1, NOT ROW 0. Row 0 is Height="Auto", so a 470px panel
               placed there would stretch the HEADER to 470px rather than float
               over the transcript. Row 1 is the star row: nothing put in it can
               change the layout of anything else. -->
          <Border x:Name="SettingsBox" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="20"
                  VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,18,0"
                  Width="430" Background="{StaticResource PanelHi}" CornerRadius="10"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="18,16,18,16">
            <Border.Effect>
              <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="THIS CONVERSATION" Style="{StaticResource Caption}" Margin="0,0,0,12"/>

              <TextBlock Text="Name" Style="{StaticResource Meta}" Margin="0,0,0,4"/>
              <TextBox x:Name="SetName" Style="{StaticResource Search}" Tag="What this conversation is called"
                       Margin="0,0,0,12"/>

              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Model" Style="{StaticResource Meta}" Margin="0,0,0,4"/>
                  <ComboBox x:Name="SetModel" Style="{StaticResource Drop}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Effort" Style="{StaticResource Meta}" Margin="0,0,0,4"/>
                  <ComboBox x:Name="SetEffort" Style="{StaticResource Drop}"/>
                </StackPanel>
              </Grid>

              <TextBlock Text="Permission mode" Style="{StaticResource Meta}" Margin="0,0,0,4"/>
              <ComboBox x:Name="SetPerm" Style="{StaticResource Drop}" Margin="0,0,0,4"/>
              <TextBlock x:Name="SetPermNote" Style="{StaticResource Meta}" TextWrapping="Wrap"
                         Margin="0,0,0,12" Text=""/>

              <CheckBox x:Name="SetRemote" Style="{StaticResource Check}" Margin="0,0,0,8"
                        Content="Remote Control - drive this conversation from your phone"/>
              <CheckBox x:Name="SetHidden" Style="{StaticResource Check}" Margin="0,0,0,4"
                        Content="Hidden - run with no terminal window"/>
              <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="22,0,0,12"
                         Text="It keeps running when this tool closes, and you can still read and answer it here."/>

              <!-- TOOL LIMITS. Last of the controls and deliberately plainest:
                   a deny list that is subtly wrong does not announce itself, it
                   just makes the session unable to do something, once, in an
                   hour's time. Space-separated, claude's own syntax. -->
              <Expander x:Name="SetToolsFold" Header="Tool limits" Margin="0,4,0,10"
                        Foreground="{StaticResource TextMid}" FontFamily="{DynamicResource FontText}" FontSize="13.5">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="Allow only these" Style="{StaticResource Meta}" Margin="0,0,0,4"/>
                  <TextBox x:Name="SetAllow" Style="{StaticResource Search}" Margin="0,0,0,9"
                           Tag="e.g.  Read Grep Bash(git *)"/>
                  <TextBlock Text="Never these" Style="{StaticResource Meta}" Margin="0,0,0,4"/>
                  <TextBox x:Name="SetDeny" Style="{StaticResource Search}" Margin="0,0,0,6"
                           Tag="e.g.  Bash(rm *) Write"/>
                  <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap"
                             Text="Space separated, exactly as claude takes them. Leave both empty for no limits at all."/>
                </StackPanel>
              </Expander>

              <TextBlock x:Name="SetPending" Style="{StaticResource Dim}" TextWrapping="Wrap"
                         Foreground="{StaticResource AccNeeds}" Visibility="Collapsed" Margin="0,0,0,10" Text=""/>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SetCancel" Content="Cancel" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
                <Button x:Name="SetApply" Content="Apply" Style="{StaticResource BtnPrimary}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- The transcript. A tail budget, said out loud at the top when it
               is truncated: the biggest conversation on this machine is 2.5 MB
               and a FlowDocument does not virtualize. -->
          <Grid Grid.Row="1">
            <FlowDocumentScrollViewer x:Name="PaneDoc"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0" Margin="0"
                                      Background="Transparent"
                                      IsSelectionEnabled="True"
                                      AutomationProperties.Name="conversation"/>
            <TextBlock x:Name="PaneEmpty" Style="{StaticResource Dim}" Text=""
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
          </Grid>

          <!-- PINNED, not inline. A question that scrolls away on a long
               conversation is a question you miss. -->
          <!-- 🪤 A PANEL INSIDE THE CARD, not a slab across it, and NOT a bar
               down its side. This was a hard 2px white rule across the full
               width; that became a 3px white bar on the left, which the
               operator disliked for the same reason the rule was wrong - it is
               a hard, saturated edge in a window where nothing else has one,
               and it reads as damage rather than as emphasis.
               The signal survives without it: this panel is the only surface in
               the pane with its own tinted ground and its own corner radius,
               and the eyebrow above the question is the one place HueAsk
               appears. A question you miss is the failure this panel exists to
               prevent, and being the only teal thing on screen prevents it more
               reliably than an edge does. -->
          <Border x:Name="AskBox" Grid.Row="2" Visibility="Collapsed"
                  Background="{StaticResource HueAskFilm}" CornerRadius="14"
                  Margin="14,0,14,14" SnapsToDevicePixels="True"
                  BorderBrush="{StaticResource HueAskEdge}" BorderThickness="1"
                  Padding="22,18,22,18">
            <!-- A long question with a description under every option can run
                 past the bottom of the pane, and an option you cannot reach is
                 an option you cannot pick. Capped and scrollable; the cap is
                 generous enough that the common three-option question never
                 scrolls at all. -->
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="AskHeader" Style="{StaticResource Caption}" Text="" Margin="0,0,0,7"
                           Foreground="{StaticResource HueAsk}"/>
                <TextBlock x:Name="AskText" Style="{StaticResource Body}" Text="" TextWrapping="Wrap"
                           FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMax}"/>
                <ItemsControl x:Name="AskOptions" Margin="0,14,0,0"/>
                <!-- The note that qualifies the WHOLE question. Below the
                     buttons, because that is where it was written. -->
                <TextBlock x:Name="AskFooter" Style="{StaticResource Dim}" Text="" TextWrapping="Wrap"
                           Margin="0,4,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="AskNote" Style="{StaticResource Meta}" Text="" TextWrapping="Wrap"
                           Margin="0,9,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border Grid.Row="3" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="18,10,18,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SendNote" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Dim}"
                         Text="" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>
              <TextBox x:Name="SendBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource Search}"
                       Tag="Type here to send it into this session's terminal - / for skills"
                       AcceptsReturn="False" Margin="0,0,8,0"
                       AutomationProperties.Name="type into this session"/>

              <!-- THE SKILL PICKER. Opens on '/' at the start of the line, the
                   same gesture that opens it inside claude itself, and filters
                   as you type. Placement=Top so it grows UPWARDS out of the
                   composer instead of off the bottom of the window. -->
              <Popup x:Name="SkillPop" PlacementTarget="{Binding ElementName=SendBox}"
                     Placement="Top" AllowsTransparency="True" StaysOpen="True"
                     HorizontalOffset="0" VerticalOffset="-6">
                <Border Background="{StaticResource PanelHi}" CornerRadius="9"
                        BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                        MinWidth="460" MaxWidth="620" Padding="0,6,0,6">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
                  </Border.Effect>
                  <StackPanel>
                    <TextBlock x:Name="SkillHint" Style="{StaticResource Caption}"
                               Margin="14,4,14,7" Text="SKILLS"/>
                    <ListBox x:Name="SkillList" Style="{StaticResource Plain}" MaxHeight="260"
                             ItemContainerStyle="{StaticResource PlainItem}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="14,7,14,7">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Body}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Blurb}" Style="{StaticResource Meta}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding Source}"
                                         Style="{StaticResource Meta}" VerticalAlignment="Center"
                                         Margin="12,0,0,0"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </Popup>
              <Button x:Name="SendBtn" Grid.Row="1" Grid.Column="1" Content="Send"
                      Style="{StaticResource BtnPrimary}" IsEnabled="False"/>
            </Grid>
          </Border>
        </Grid>
        </Border>
      </Grid>

      <!-- ===== SESSION MANAGER: one full-width table =====
           Deliberately a different SHAPE, not a different colour. Ported in
           phase 4; the frame exists here so the switch is real from phase 1. -->
      <!-- 🔴 ONE CARD, ON THE SAME GROUND AS THE WORK SURFACE. The manager was
           a flat full-bleed table while the work surface had become three
           floating cards, so switching surfaces switched design languages
           halfway through the window. It is deliberately a different SHAPE - one
           wide table rather than three columns - but it is the same material. -->
      <Grid x:Name="ManageSurface" Visibility="Collapsed" Background="{StaticResource Ink}">
        <Border Background="{StaticResource Panel}" CornerRadius="12" Margin="10,4,10,10"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                SnapsToDevicePixels="True">
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.42" Color="#000000"/>
          </Border.Effect>
        <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PanelHi}" CornerRadius="11,11,0,0"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="18,11,18,11">
          <!-- THE SAME COLUMN WIDTHS AS ManageRowTpl, and for the same reason a
               table has a header row at all: a caption made of padded spaces
               lines up with nothing, because the rows below it are a Grid and
               the caption was not. Change a width here, change it there. -->
          <Grid x:Name="ManageCaption">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 🔴 EACH ONE SORTS. They were inert TextBlocks that looked exactly
                 like the sortable headers of every other table on the machine,
                 which is why the operator clicked one and reported the filter
                 broken. Tag carries the sort key; the arrow says which way. -->
            <TextBlock x:Name="HdrLogon" Grid.Column="0" Tag="logon" Text="LOGON"
                       Style="{StaticResource Caption}" HorizontalAlignment="Center" Cursor="Hand"/>
            <TextBlock x:Name="HdrName" Grid.Column="1" Tag="name" Text="CONVERSATION"
                       Style="{StaticResource Caption}" Margin="14,0,10,0" Cursor="Hand"/>
            <TextBlock x:Name="HdrLane" Grid.Column="2" Tag="lane" Text="LANE"
                       Style="{StaticResource Caption}" Margin="0,0,10,0" Cursor="Hand"/>
            <TextBlock x:Name="HdrSaid" Grid.Column="3" Tag="said" Text="WHAT IT LAST SAID"
                       Style="{StaticResource Caption}" Cursor="Hand"/>
            <TextBlock x:Name="HdrAge" Grid.Column="4" Tag="age" Text="AGE"
                       Style="{StaticResource Caption}" Margin="10,0,0,0" Cursor="Hand"/>
          </Grid>
        </Border>
        <!-- 🔴 THE FILTER STRIP. The manager had sorting and nothing else - no
             way to ask "just the ticked ones" or "just what is running", which
             is the question this surface exists to answer before a logon. The
             chips are exclusive: a filter that can be half-on in four
             directions at once is a state nobody can read off the screen. -->
        <Border Grid.Row="1" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1"
                Padding="18,8,18,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="SHOW" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <RadioButton x:Name="MgrAll" Content="Everything" Style="{StaticResource Seg}"
                         GroupName="mgrfilter" IsChecked="True"/>
            <RadioButton x:Name="MgrTicked" Content="Ticked" Style="{StaticResource Seg}"
                         GroupName="mgrfilter"/>
            <RadioButton x:Name="MgrRunning" Content="Running" Style="{StaticResource Seg}"
                         GroupName="mgrfilter"/>
            <RadioButton x:Name="MgrNeeds" Content="Needs you" Style="{StaticResource Seg}"
                         GroupName="mgrfilter"/>
            <TextBlock x:Name="MgrFilterNote" Style="{StaticResource Meta}" VerticalAlignment="Center"
                       Margin="14,0,0,0" Text=""/>
          </StackPanel>
        </Border>

        <ListBox x:Name="ManageList" Grid.Row="2" Style="{StaticResource Plain}"
                 ItemContainerStyle="{StaticResource PlainItem}"
                 ItemTemplate="{StaticResource ManageRowTpl}"
                 AutomationProperties.Name="the ticked set"/>
        <Border Grid.Row="3" Background="{StaticResource Rail}" CornerRadius="0,0,11,11"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="18,12,18,12">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="THE TICKED SET" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button x:Name="OpenNotRunning" Content="Open not running" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
            <Button x:Name="RelaunchSessions" Content="Relaunch sessions" Style="{StaticResource Btn}"/>
            <TextBlock x:Name="ManageCount" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="14,0,0,0"/>
          </StackPanel>
        </Border>
        </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- ========== 3. status ========== -->
    <Border Grid.Row="3" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="18,8,18,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Grid.Column="0" Style="{StaticResource Dim}" Text=""
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <!-- No Close here any more: the title bar has one, and two buttons
               that do the same thing in one window is one too many. The '?'
               that used to sit here had no handler at all - a control that does
               nothing when pressed is the exact defect this window was rebuilt
               to stop having. -->
          <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource BtnPrimary}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================== 4. THE SHEET ==================
         Every question the window asks used to be a stock Windows MessageBox:
         a grey 3D dialog in Segoe UI with a shield icon, thrown up in front of
         a dark window that shares none of its vocabulary. It was also the only
         part of the tool that could not be restyled, so the more the window
         improved the more the dialogs stood out - and they appear at exactly
         the moments that matter (closing live sessions, discarding ticks).

         🪤 SCRIM AND CARD ARE TWO ELEMENTS ON PURPOSE, NOT ONE PANEL.
         The scrim has to cover the HEADER too or the dim reads as half-applied,
         which means spanning rows 0-3 - and rows 0, 1 and 3 are Height="Auto".
         Anything with a real desired size placed across them inflates them
         (the same trap already documented on SettingsBox above). A Rectangle
         with no Width/Height has a desired size of ZERO and cannot inflate
         anything, while still painting across the whole span. The card, which
         does have a size, therefore lives alone in row 2 - the star row, where
         nothing it does can change the layout of anything else.
         ================================================== -->
    <Rectangle x:Name="Scrim" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="100"
               Visibility="Collapsed" Fill="#000000" Opacity="0.62"/>

    <Grid x:Name="Sheet" Grid.Row="2" Panel.ZIndex="101" Visibility="Collapsed">
      <Border MaxWidth="560" MaxHeight="480" VerticalAlignment="Center"
              HorizontalAlignment="Center" Margin="24"
              Background="{StaticResource Sheet}" CornerRadius="14"
              BorderBrush="{StaticResource EdgeLit}" BorderThickness="1"
              Padding="26,22,26,20" SnapsToDevicePixels="True">
        <Border.Effect>
          <DropShadowEffect BlurRadius="52" ShadowDepth="16" Opacity="0.7" Color="#000000"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Display, not H1. At 15px the question read at exactly the same
               size as the pane name behind it, which is the wrong weighting for
               the only thing on screen the operator is being asked to answer. -->
          <TextBlock x:Name="SheetTitle" Grid.Row="0" Style="{StaticResource Display}"
                     TextWrapping="Wrap" Margin="0,0,0,14" Text=""/>

          <!-- The bodies name every conversation an action will touch, so this
               scrolls rather than trimming: a list you cannot read to the end
               is not a confirmation. -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,20">
            <TextBlock x:Name="SheetBody" Style="{StaticResource Body}"
                       TextWrapping="Wrap" LineHeight="20" Text=""/>
          </ScrollViewer>

          <!-- Three at most, right-aligned, the primary last: the rightmost
               button is the one Enter presses and the one the eye lands on. -->
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SheetB1" Style="{StaticResource Btn}" Margin="0,0,8,0"
                    Visibility="Collapsed" MinWidth="92"/>
            <Button x:Name="SheetB2" Style="{StaticResource Btn}" Margin="0,0,8,0"
                    Visibility="Collapsed" MinWidth="92"/>
            <Button x:Name="SheetB3" Style="{StaticResource BtnPrimary}"
                    Visibility="Collapsed" MinWidth="92"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  </Border>
</Window>
