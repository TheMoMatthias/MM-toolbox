<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude sessions"
        Width="1480" Height="980" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="#0F1013">

  <Window.Resources>

    <!-- ================== PALETTE ==================
         Colour is allowed here for the first time, and it carries exactly one
         meaning: WHAT A CONVERSATION NEEDS FROM YOU. Every accent is twinned
         with a glyph and a band heading, so the screen still reads correctly in
         a screenshot, on a monochrome display, or to somebody who cannot tell
         these hues apart. Colour is the fast path; it is never the only path.
         ============================================ -->
    <SolidColorBrush x:Key="Ink"       Color="#0F1013"/>
    <SolidColorBrush x:Key="Panel"     Color="#15161A"/>
    <SolidColorBrush x:Key="PanelHi"   Color="#1B1D22"/>
    <SolidColorBrush x:Key="Rail"      Color="#121317"/>
    <SolidColorBrush x:Key="Hairline"  Color="#26282E"/>
    <SolidColorBrush x:Key="HairSoft"  Color="#1E2025"/>

    <SolidColorBrush x:Key="TextMax"   Color="#F2F3F5"/>
    <SolidColorBrush x:Key="TextHigh"  Color="#D6D8DC"/>
    <SolidColorBrush x:Key="TextMid"   Color="#9AA0A8"/>
    <SolidColorBrush x:Key="TextLow"   Color="#6B7178"/>

    <!-- The band accents. One per band, and nothing else in this file is
         allowed to use them. Clay is Claude's own, and it marks the only band
         that is an interruption. -->
    <SolidColorBrush x:Key="AccNeeds"   Color="#D97757"/>
    <SolidColorBrush x:Key="AccWorking" Color="#5B8DEF"/>
    <SolidColorBrush x:Key="AccDone"    Color="#4ADE80"/>
    <SolidColorBrush x:Key="AccIdle"    Color="#8A9099"/>
    <SolidColorBrush x:Key="AccQuiet"   Color="#4A5058"/>
    <SolidColorBrush x:Key="Focus"      Color="#D97757"/>

    <SolidColorBrush x:Key="SelBg"     Color="#22252B"/>
    <SolidColorBrush x:Key="HoverBg"   Color="#1A1C21"/>

    <FontFamily x:Key="FontUi">Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ================== TYPE ================== -->
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextLow}"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
    </Style>
    <Style x:Key="Dim" TargetType="TextBlock" BasedOn="{StaticResource Body}">
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <!-- ================== SCROLLBAR ==================
         Thin, dark, and out of the way. A default WPF scrollbar is the single
         loudest thing on a dark surface. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" Margin="2,0,2,0" Background="#33383F"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== BUTTONS ================== -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
      <Setter Property="Padding" Value="11,6,11,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="{StaticResource PanelHi}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#23262C"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="#141518"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="{StaticResource AccNeeds}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The surface switch. Two segments, and the CHECKED one is filled: the
         two surfaces differ by shape, so the switch has to say plainly which
         shape you are looking at. -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="Padding" Value="13,6,13,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="5" Background="Transparent"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource SelBg}"/>
                <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/>
                <Setter TargetName="b" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== SEARCH BOX ================== -->
    <Style x:Key="Search" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccNeeds}"/>
      <Setter Property="Padding" Value="10,7,10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="7" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Focus}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== LIST BASE ==================
         Virtualizing and recycling on purpose: the sessions column can hold
         every conversation in the registry, and a ListBox that realises 214
         two-line rows is a visible stall on every rebuild. -->
    <Style x:Key="Plain" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained"/>
    </Style>

    <Style x:Key="PlainItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBg}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource SelBg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- ================== THE SESSION ROW ==================
         TWO LINES, because the one thing that makes this list scannable is what
         each conversation last SAID, and a 336px column cannot hold that on the
         same line as a name. Line one is identity and age; line two is the last
         thing it said, ellipsised.

         The band accent appears as a 3px bar down the left of a row and as a dot
         beside the name - never as the only signal. The band HEADING above it
         says the same thing in words, so the grouping survives without colour.

         Visibility is a property ON THE ROW OBJECT rather than a converter:
         PowerShell can set System.Windows.Visibility directly and it binds with
         no extra type in the way.
         ==================================================== -->
    <DataTemplate x:Key="SessionRowTpl">
      <Grid>
        <!-- the band heading -->
        <Border Visibility="{Binding BandVis}" Padding="16,14,12,6">
          <StackPanel Orientation="Horizontal">
            <Border Width="3" Height="11" CornerRadius="2" Background="{Binding Accent}"
                    VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding BandLabel}" FontFamily="Segoe UI" FontSize="10.5"
                       FontWeight="SemiBold" Foreground="{Binding Accent}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding BandCount}" FontFamily="Segoe UI" FontSize="10.5"
                       Foreground="#6B7178" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- a conversation -->
        <Border Visibility="{Binding RowVis}" Padding="0,7,12,7">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{Binding Accent}" Opacity="{Binding BarOpacity}"/>
            <StackPanel Grid.Column="1" Margin="13,0,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding Accent}"
                         Visibility="{Binding DotVis}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Segoe UI" FontSize="12.5"
                           FontWeight="{Binding NameWeight}" FontStyle="{Binding NameStyle}"
                           Foreground="#F2F3F5" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Age}" FontFamily="Segoe UI" FontSize="10.5"
                           Foreground="#6B7178" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{Binding Said}" FontFamily="Segoe UI" FontSize="11.5"
                         Foreground="#9AA0A8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <!-- The rail row: a project, its conversation count, and whether it is the
         one currently filtering. It FILTERS - it is never the grouping. -->
    <DataTemplate x:Key="RailRowTpl">
      <Border Padding="16,6,12,6" Background="{Binding PickBg}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Label}" FontFamily="Segoe UI" FontSize="12"
                     Foreground="{Binding Fg}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="1" Text="{Binding Count}" FontFamily="Segoe UI" FontSize="10.5"
                     Foreground="#6B7178" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </DataTemplate>


    <!-- ================== THE MANAGER ROW ==================
         A FULL WIDTH TABLE, and that is the point: the session manager differs
         from the work surface by SHAPE, so the two can never be mistaken for one
         another - in a screenshot, on a monochrome screen, or by a reader who
         cannot tell the accents apart.

         The LOGON tick is the first column and fenced off by a rule, because it
         is the one control on this screen that decides tomorrow morning. It is a
         checkbox and it never launches anything.
         ===================================================== -->
    <DataTemplate x:Key="ManageRowTpl">
      <Grid>
        <!-- a project header -->
        <Border Visibility="{Binding ProjVis}" Padding="0,9,18,7" Background="#15161A">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Caret}" FontFamily="Segoe UI" FontSize="11"
                       Foreground="#6B7178" HorizontalAlignment="Right" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Label}" FontFamily="Segoe UI" FontSize="12.5"
                       FontWeight="SemiBold" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="{Binding Meta}" FontFamily="Segoe UI" FontSize="11"
                       Foreground="#6B7178"/>
          </Grid>
        </Border>

        <!-- a conversation -->
        <Border Visibility="{Binding ConvVis}" Padding="0,5,18,5">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Named so the click handler can tell "clicked the box" from
                 "clicked the row". A wider transparent hit area than the 15px
                 mark, because a checkbox you have to aim at is a checkbox that
                 reads as broken. -->
            <Border Grid.Column="0" x:Name="TickBox" Background="Transparent" Cursor="Hand"
                    ToolTip="Click to tick - a ticked conversation reopens at your next logon">
              <Border Width="15" Height="15" CornerRadius="3" HorizontalAlignment="Center"
                      VerticalAlignment="Center" BorderBrush="#3A3F47" BorderThickness="1.4"
                      Background="{Binding TickBg}"/>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Segoe UI" FontSize="12.5"
                       FontStyle="{Binding NameStyle}" Foreground="#D6D8DC"
                       TextTrimming="CharacterEllipsis" Margin="14,0,10,0"/>
            <TextBlock Grid.Column="2" Text="{Binding Lane}" FontFamily="Segoe UI" FontSize="11"
                       Foreground="#6B7178" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="3" Text="{Binding Said}" FontFamily="Segoe UI" FontSize="11.5"
                       Foreground="#9AA0A8" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="4" Text="{Binding Age}" FontFamily="Segoe UI" FontSize="10.5"
                       Foreground="#6B7178" Margin="10,0,0,0"/>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

  </Window.Resources>

  <!-- =========================================================================
       THE SHELL. Four rows: title bar, surface switch, the body, status.
       The BODY is where the two surfaces differ, and they differ by SHAPE:
         work surface    three columns  - rail | sessions | output pane
         session manager one full-width table
       Only one of the two is ever visible.
       ========================================================================= -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ========== 0. title ========== -->
    <Border Grid.Row="0" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="18,12,18,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Claude sessions" Style="{StaticResource H1}" VerticalAlignment="Center"/>
          <TextBlock x:Name="LiveCount" Style="{StaticResource Dim}" Margin="14,0,0,0"
                     VerticalAlignment="Center" Text=""/>
        </StackPanel>
        <TextBox x:Name="Search" Grid.Column="1" Style="{StaticResource Search}"
                 MaxWidth="560" MinWidth="380" HorizontalAlignment="Center"
                 ToolTip="Find by title, id, worktree or project. Press / from anywhere."/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="Stamp" Style="{StaticResource Dim}" Margin="0,0,12,0" VerticalAlignment="Center"/>
          <Button x:Name="Rescan" Content="Rescan" Style="{StaticResource Btn}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========== 1. which surface ========== -->
    <Border Grid.Row="1" Background="{StaticResource Ink}"
            BorderBrush="{StaticResource HairSoft}" BorderThickness="0,0,0,1" Padding="18,9,18,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="7"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="3">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ModeWork" Style="{StaticResource Seg}" Content="Work surface" IsChecked="True"
                         ToolTip="What is happening now: every conversation that is running or was, grouped by what it needs from you."/>
            <RadioButton x:Name="ModeManage" Style="{StaticResource Seg}" Content="Session manager"
                         ToolTip="What comes back at logon: every conversation by project, with the tick that decides."/>
          </StackPanel>
        </Border>
        <StackPanel x:Name="BandChips" Grid.Column="1" Orientation="Horizontal"
                    Margin="16,0,0,0" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Broadcast" Content="Send to many" Style="{StaticResource Btn}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========== 2. the body ========== -->
    <Grid Grid.Row="2">

      <!-- ===== WORK SURFACE: rail | sessions | output pane =====
           The splitters are real, and their widths are remembered. The rail and
           the sessions column collapse on narrow windows: see Set-Breakpoint in
           the script. Three columns is not a luxury that vanishes when the
           window is small, it is a layout with a defined behaviour at every
           width. -->
      <Grid x:Name="WorkSurface">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="RailCol" Width="208" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition x:Name="ListCol" Width="336" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- the projects rail: a FILTER, never the grouping -->
        <Border x:Name="RailPane" Grid.Column="0" Background="{StaticResource Rail}"
                BorderBrush="{StaticResource HairSoft}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="16,12,12,8">
              <Grid>
                <TextBlock Text="PROJECTS" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock x:Name="RailClear" Text="clear" Style="{StaticResource Dim}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Cursor="Hand" Visibility="Collapsed"
                           ToolTip="Stop filtering by project."/>
              </Grid>
            </Border>
            <ListBox x:Name="RailList" Grid.Row="1" Style="{StaticResource Plain}"
                     ItemContainerStyle="{StaticResource PlainItem}"
                     ItemTemplate="{StaticResource RailRowTpl}"
                     AutomationProperties.Name="projects"/>
          </Grid>
        </Border>

        <GridSplitter x:Name="RailSplit" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- the sessions column: grouped by BAND, two lines per row -->
        <Border x:Name="ListPane" Grid.Column="2" Background="{StaticResource Ink}"
                BorderBrush="{StaticResource HairSoft}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="16,12,12,8">
              <Grid>
                <TextBlock x:Name="ListCaption" Text="SESSIONS" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ListCount" Style="{StaticResource Dim}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ListBox x:Name="SessionList" Grid.Row="1" Style="{StaticResource Plain}"
                     ItemContainerStyle="{StaticResource PlainItem}"
                     ItemTemplate="{StaticResource SessionRowTpl}"
                     AutomationProperties.Name="sessions"/>
          </Grid>
        </Border>

        <GridSplitter x:Name="ListSplit" Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext"/>

        <!-- the output pane: header, transcript, pinned question, composer -->
        <Grid x:Name="OutputPane" Grid.Column="4" Background="{StaticResource Ink}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="18,12,18,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="PaneName" Style="{StaticResource H1}" Text="" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <Border x:Name="PaneStateDot" Width="7" Height="7" CornerRadius="4"
                          Background="{StaticResource AccIdle}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <TextBlock x:Name="PaneState" Style="{StaticResource Dim}" Text=""/>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PaneGoTo" Content="Go to terminal" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
                <Button x:Name="PaneRelaunch" Content="Relaunch" Style="{StaticResource Btn}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- The transcript. A tail budget, said out loud at the top when it
               is truncated: the biggest conversation on this machine is 2.5 MB
               and a FlowDocument does not virtualize. -->
          <Grid Grid.Row="1">
            <FlowDocumentScrollViewer x:Name="PaneDoc"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0" Margin="0"
                                      Background="Transparent"
                                      IsSelectionEnabled="True"
                                      AutomationProperties.Name="conversation"/>
            <TextBlock x:Name="PaneEmpty" Style="{StaticResource Dim}" Text=""
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
          </Grid>

          <!-- PINNED, not inline. A question that scrolls away on a long
               conversation is a question you miss. -->
          <Border x:Name="AskBox" Grid.Row="2" Visibility="Collapsed"
                  Background="{StaticResource PanelHi}"
                  BorderBrush="{StaticResource AccNeeds}" BorderThickness="0,2,0,0"
                  Padding="18,12,18,12">
            <StackPanel>
              <TextBlock x:Name="AskHeader" Style="{StaticResource Caption}" Text="" Margin="0,0,0,4"/>
              <TextBlock x:Name="AskText" Style="{StaticResource Body}" Text="" TextWrapping="Wrap"/>
              <ItemsControl x:Name="AskOptions" Margin="0,9,0,0"/>
              <TextBlock x:Name="AskNote" Style="{StaticResource Dim}" Text="" TextWrapping="Wrap"
                         Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="3" Background="{StaticResource Panel}"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="18,10,18,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SendNote" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Dim}"
                         Text="" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>
              <TextBox x:Name="SendBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource Search}"
                       AcceptsReturn="False" Margin="0,0,8,0"
                       AutomationProperties.Name="type into this session"/>
              <Button x:Name="SendBtn" Grid.Row="1" Grid.Column="1" Content="Send"
                      Style="{StaticResource BtnPrimary}" IsEnabled="False"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- ===== SESSION MANAGER: one full-width table =====
           Deliberately a different SHAPE, not a different colour. Ported in
           phase 4; the frame exists here so the switch is real from phase 1. -->
      <Grid x:Name="ManageSurface" Visibility="Collapsed" Background="{StaticResource Ink}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PanelHi}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="18,9,18,9">
          <!-- THE SAME COLUMN WIDTHS AS ManageRowTpl, and for the same reason a
               table has a header row at all: a caption made of padded spaces
               lines up with nothing, because the rows below it are a Grid and
               the caption was not. Change a width here, change it there. -->
          <Grid x:Name="ManageCaption">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="180"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="LOGON" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="CONVERSATION" Style="{StaticResource Caption}" Margin="14,0,10,0"/>
            <TextBlock Grid.Column="2" Text="LANE" Style="{StaticResource Caption}" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="3" Text="WHAT IT LAST SAID" Style="{StaticResource Caption}"/>
            <TextBlock Grid.Column="4" Text="AGE" Style="{StaticResource Caption}" Margin="10,0,0,0"/>
          </Grid>
        </Border>
        <ListBox x:Name="ManageList" Grid.Row="1" Style="{StaticResource Plain}"
                 ItemContainerStyle="{StaticResource PlainItem}"
                 ItemTemplate="{StaticResource ManageRowTpl}"
                 AutomationProperties.Name="the ticked set"/>
        <Border Grid.Row="2" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="18,10,18,10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="THE TICKED SET" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button x:Name="OpenNotRunning" Content="Open not running" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
            <Button x:Name="RelaunchSessions" Content="Relaunch sessions" Style="{StaticResource Btn}"/>
            <TextBlock x:Name="ManageCount" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="14,0,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ========== 3. status ========== -->
    <Border Grid.Row="3" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="18,8,18,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Grid.Column="0" Style="{StaticResource Dim}" Text=""
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="HelpBtn" Content="?" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
          <Button x:Name="CloseBtn" Content="Close" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
          <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource BtnPrimary}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
