<!--
    The window for sessions-gui.ps1, loaded with [Windows.Markup.XamlReader].
    It therefore carries NO x:Class and NO event attributes: every handler is
    wired from PowerShell by x:Name, or by one routed handler on a container.

    ASCII ONLY. PowerShell 5.1 reads a no-BOM file as ANSI, so a non-ASCII byte
    here comes back mojibaked. Every mark on this screen is therefore drawn as
    vector geometry rather than typed as a character, which is both ASCII-safe
    and immune to font substitution.
    An XML comment may not contain a double hyphen, which is why the banners
    below are written with '=' rather than a rule of dashes.

    MONOCHROME. Black, white and greys only, no hue anywhere. Every colour in
    this file is defined ONCE in the PALETTE block at the top of Window.Resources
    and referenced by key; there is no raw hex below it. sessions-gui.ps1 reads
    the same brushes back out of these resources by name, so the row colours and
    the chrome cannot drift apart. To change the palette, change that one block.

    Meaning that used to come from hue now comes from five other channels:
      VALUE   the grey ramp. TextMax is reserved for what matters most: a live
              conversation, one that is waiting for you, the selected row, a
              failure. Inert things sit at TextDim.
      WEIGHT  and CASE. LIVE (bold, upper) is a process holding the id and is
              certain; live (regular, lower) is a transcript that moved recently
              and is inferred. That distinction is semantic and load-bearing.
      GLYPH   every mark is a drawn SHAPE: a filled square is a tick, a filled
              dot a held session, a hollow dot an inferred one, a drawn X a
              conversation that can never be launched, a chevron a conversation
              at its prompt, rising bars one that is working, shrinking rules one
              that is compacting. A hex id in a mono font is a row of collinear
              crossbars and reads as a rule at small sizes, so a thin line cannot
              be trusted to mean anything here.
      SURFACE a lifted band and a left bar for the selected row; hairline rules
              rather than tinting to separate one column group from the next.
      MOTION  120 to 180 ms eases, and only where they carry structure: a row
              lifting under the pointer, the list settling after the hierarchy
              changed, a card arriving over a scrim, the wheel gliding instead of
              jumping a whole row at a time. Nothing here animates for decoration.

    THE THREE THINGS THIS WINDOW SAYS, AND WHY THEY MUST NOT BLUR TOGETHER:
      the CHECKBOX (far left, under "LOGON") decides what comes back at the next
        logon. Ticking never launches anything.
      OPEN? (right of centre) is LIVENESS: is a process holding this
        conversation. Mono type, upper/lower case, a dot or an X.
      DOING (beside it) is STATE: what that conversation is actually doing right
        now. Proportional type, always lower case, its own vocabulary of drawn
        glyphs, fenced off by its own short rule.
      the OPEN button (far right, under "RIGHT NOW") opens a conversation NOW,
        whatever its tick says. Launching never reads the tick.
    Liveness and state are DIFFERENT QUESTIONS. A conversation can be LIVE and
    waiting, LIVE and working, or not live at all and still carry the last state
    it was seen in. Nothing on this screen renders one as if it were the other.

    TEXT RENDERING. TextFormattingMode is Ideal, not Display. Display snaps glyph
    outlines and advance widths to whole pixels, which at these sizes visibly
    coarsens every letterform, and it is what made a mono hex id read as struck
    through last round. Measured 2026-08-22: both of this machine's monitors are
    3440x1440 at 100 per cent scaling, so there is no DPI bitmap scaling in play
    at all and Display mode was the whole of the blur.

    Column widths are repeated in the header row and in the row template. They
    are plain numbers in both places and must be kept in step by hand; a
    SharedSizeGroup cannot span the star column that carries the name.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Claude sessions"
    Width="1480" Height="980" MinWidth="1180" MinHeight="700"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource Ink}"
    Foreground="{DynamicResource TextHigh}"
    FontFamily="Segoe UI Variable Text, Segoe UI, Tahoma"
    FontSize="13"
    UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    TextOptions.TextHintingMode="Fixed">

  <Window.Resources>

    <!-- ================== PALETTE - the only colours in this file ==================
         Every value is a TRUE grey: R, G and B are equal in all of them, so
         there is no residual tint anywhere.

         Measured contrast (WCAG 2.1), text against Ink / against Raised, which
         is the lightest surface any of it sits on:
           TextMax  18.1 / 14.5     TextHigh 12.9 / 10.4     TextMid 8.5 / 6.8
           TextLow   5.7 /  4.6     TextDim   4.3 /  3.5
         Adjacent tiers are 1.33x to 1.52x apart, so they read as steps.

         TextLow is the FLOOR FOR PROSE at 4.6:1 worst case - the legend, the
         paths, the row notes and the probe line all sit there or above.
         TextDim is only ever captions, ids, placeholder text and inert marks:
         short, glanceable, never a sentence. Nothing below TextDim is text.
    ========================================================================== -->

    <!-- surfaces, darkest first -->
    <SolidColorBrush x:Key="Ink"        Color="#0C0C0C"/>
    <SolidColorBrush x:Key="Panel"      Color="#141414"/>
    <SolidColorBrush x:Key="PanelHi"    Color="#181818"/>
    <SolidColorBrush x:Key="RowHover"   Color="#171717"/>
    <SolidColorBrush x:Key="Field"      Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Raised"     Color="#232323"/>
    <SolidColorBrush x:Key="BtnBg"      Color="#1D1D1D"/>
    <SolidColorBrush x:Key="BtnHover"   Color="#282828"/>
    <SolidColorBrush x:Key="BtnPress"   Color="#323232"/>
    <SolidColorBrush x:Key="Scrim"      Color="#DE000000"/>

    <!-- rules -->
    <SolidColorBrush x:Key="Hairline"   Color="#2E2E2E"/>
    <SolidColorBrush x:Key="HairlineHi" Color="#424242"/>

    <!-- text, brightest first -->
    <SolidColorBrush x:Key="TextMax"    Color="#F6F6F6"/>
    <SolidColorBrush x:Key="TextHigh"   Color="#D2D2D2"/>
    <SolidColorBrush x:Key="TextMid"    Color="#ABABAB"/>
    <SolidColorBrush x:Key="TextLow"    Color="#8B8B8B"/>
    <SolidColorBrush x:Key="TextDim"    Color="#767676"/>

    <!-- marks and furniture -->
    <SolidColorBrush x:Key="Thumb"      Color="#373737"/>
    <SolidColorBrush x:Key="ThumbHi"    Color="#565656"/>

    <!-- ================== TYPE ==================
         Three optical sizes of one modern face, plus one mono, each with a real
         fallback chain that degrades to something present on every Windows.
         Segoe UI Variable is cut per optical size: Small is drawn for captions,
         Text for reading sizes, Display for headings. Using the right one is
         what separates this from simply picking a point size.
           FontDisplay  headings, 17px and up
           FontText     everything that is read, 12 to 16px
           FontSmall    captions and column headings, 10 to 11.5px
           FontMono     ids, paths and the liveness word, where a fixed advance
                        is the point. Cascadia is the modern cut; Consolas is
                        the fallback and was measured cleaner than Cascadia at
                        10.5px under the OLD Display formatting mode. Under
                        Ideal that penalty is gone, which is why the whole
                        window can now use one coherent mono.
    ========================================================================== -->
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="FontSmall">Segoe UI Variable Small, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource FontSmall}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The poles of the screen get the only bold captions, so the eye finds
         them before it finds anything else on a heading row. -->
    <Style x:Key="PoleCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- A ROW'S OWN ACTIONS, ON THE ROW YOU ARE POINTING AT.
         Eighteen identical "Open  +" pairs stacked down the right edge is a
         column of noise that says the same word eighteen times. They belong to
         whichever row you are pointing at, plus the SELECTED row - which is
         always exactly one, so the affordance is never entirely absent and
         never has to be discovered by accident.

         Hidden, not Collapsed: the space stays reserved so rows do not reflow
         under the pointer, and a Hidden element is not hit-testable, so there
         is nothing to click by mistake either. -->
    <Style x:Key="RowActions" TargetType="Grid">
      <Setter Property="Visibility" Value="Hidden"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A COLUMN HEADING YOU CAN SORT BY.
         Looks like a caption and behaves like a button: no chrome at rest, a
         rule underneath on hover so it is discoverable by pointing at it, and
         the arrow the code appends is the only permanent difference between a
         sorted column and an unsorted one. -->
    <Style x:Key="SortCap" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource FontSmall}"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="0,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextDim}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The label in front of a group of filter chips. Quieter than a pole
         caption: it names a dimension, it is not one of the two poles. -->
    <Style x:Key="GroupCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- ================== SCROLLBAR ================== -->
    <Style x:Key="SlimThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" Background="{StaticResource Thumb}" CornerRadius="4" Margin="3,2,3,2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="t"
                                      Storyboard.TargetProperty="Background.Color"
                                      To="#565656" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <ColorAnimation Storyboard.TargetName="t"
                                      Storyboard.TargetProperty="Background.Color"
                                      To="#373737" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Style="{StaticResource SlimThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== BUTTONS ==================
         Four tiers, told apart by border strength, text value and fill, never by
         hue. Btn is the neutral default; BtnNow is anything that acts on the
         world NOW - launch, spawn - and wears a brighter border, a brighter
         label and semibold weight; BtnTick changes the logon selection only and
         is deliberately quieter; BtnPrimary is the one FILLED button on any
         given screen and means "this is the commit".
         The hover is a 120 ms fade of a lifted layer rather than a hard swap, so
         a pointer crossing the toolbar does not strobe. -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="Background" Value="{StaticResource BtnBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="b" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
              <Border x:Name="lift" Background="{StaticResource BtnHover}" CornerRadius="6" Opacity="0"/>
              <Border x:Name="edge" BorderBrush="{StaticResource HairlineHi}" BorderThickness="1" CornerRadius="6" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="edge" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                      <DoubleAnimation Storyboard.TargetName="edge" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource BtnPress}"/>
                <Setter TargetName="lift" Property="Opacity" Value="0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Acts on the world NOW: the launch and spawn buttons, and nothing else.
         Named for what it does rather than for the fill it used to carry. A key
         that describes an appearance outlives the appearance and then misleads
         whoever reads it next. -->
    <Style x:Key="BtnNow" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
      <Setter Property="BorderBrush" Value="{StaticResource HairlineHi}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Changes the logon selection. Neutral, deliberately quieter than BtnNow. -->
    <Style x:Key="BtnTick" TargetType="Button" BasedOn="{StaticResource Btn}"/>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{StaticResource TextHigh}"/>
      <Setter Property="BorderBrush" Value="{StaticResource TextHigh}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="b" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
              <Border x:Name="lift" Background="{StaticResource TextMax}" CornerRadius="6" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource TextMid}"/>
                <Setter TargetName="lift" Property="Opacity" Value="0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The in-row OPEN button. The only thing in a row that launches anything. -->
    <Style x:Key="BtnRow" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="11,3"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="BorderBrush" Value="{StaticResource HairlineHi}"/>
      <Setter Property="MinWidth" Value="62"/>
    </Style>

    <!-- The in-row spawn button. Quieter than OPEN: it is the rarer act. -->
    <Style x:Key="BtnRowQuiet" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="MinWidth" Value="30"/>
    </Style>

    <!-- Chrome-free square button: the fold chevron and the pin. -->
    <Style x:Key="BtnBare" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="lift" Background="{StaticResource BtnHover}" CornerRadius="4" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== THE TICK ==================
         Filled versus hollow, which is the one distinction that survives with no
         hue at all: ticked is a solid white square carrying a dark check, and
         unticked is an empty square with a hairline edge. Nothing else on the
         screen is a small square, so the mark is unambiguous on its own. -->
    <Style x:Key="TickBox" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="box" Width="18" Height="18" CornerRadius="4"
                    Background="Transparent" BorderBrush="{StaticResource HairlineHi}" BorderThickness="1.4">
              <Path x:Name="chk" Visibility="Collapsed"
                    Data="M 0,4.2 L 3.6,7.8 L 10,0.6"
                    Stroke="{StaticResource Ink}" StrokeThickness="2.2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource TextMid}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource TextMax}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource TextMax}"/>
                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="box" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== THE FILTER CHIP ==================
         A ToggleButton, and the ONLY pill-shaped thing on the screen, so a
         filter can never be mistaken for a button that does something.
         APPLIED is a solid fill with dark text, which is the same "filled means
         on" language the tick already uses. NOT applied is an outline. That is
         deliberate: the operator has to be able to see what is being filtered
         out at a glance, and a filled chip against four hollow ones does that
         without reading a word of it. -->
    <!-- THE COUNT PILLS, as buttons.
         They were plain TextBlocks inside Borders, which is exactly what made
         the operator ask why clicking "live now" did nothing: it LOOKED like a
         control and was not one. Anything shaped like a pill in this window is
         now pressable, and each one takes you to its band in the inbox. -->
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="11,4"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="shell"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    CornerRadius="6" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="shell" Property="Background" Value="{StaticResource Raised}"/>
                <Setter TargetName="shell" Property="BorderBrush" Value="{StaticResource HairlineHi}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="shell" Property="Background" Value="{StaticResource PanelHi}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- THE VIEW SWITCH. Three exclusive modes, rendered as one segmented
         control so it reads as "which of these am I looking at" rather than as
         three unrelated buttons. The selected segment is FILLED, matching the
         filled-means-on language the ticks and chips already use. -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextLow}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="seg" Background="Transparent" CornerRadius="5"
                    Padding="12,5" SnapsToDevicePixels="True">
              <TextBlock x:Name="lab" Text="{TemplateBinding Content}"
                         Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="seg" Property="Background" Value="{StaticResource Raised}"/>
                <Setter TargetName="lab" Property="Foreground" Value="{StaticResource TextHigh}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="seg" Property="Background" Value="{StaticResource TextMax}"/>
                <Setter TargetName="lab" Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextLow}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="b" Background="Transparent" BorderBrush="{StaticResource Hairline}"
                      BorderThickness="1" CornerRadius="10"/>
              <Border x:Name="fill" Background="{StaticResource TextHigh}" CornerRadius="10" Opacity="0"/>
              <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextDim}"/>
                <Setter Property="Foreground" Value="{StaticResource TextHigh}"/>
              </Trigger>
              <!-- A LIT CHIP IS DARK TEXT ON A PALE FILL, and the fill is set
                   here as a plain Setter rather than left to the animation.

                   It used to be the animation alone. That put a chip's whole
                   legibility on the clock: Foreground flips to Ink (#0C0C0C)
                   the instant IsChecked goes true, while fill.Opacity was still
                   0 until a Storyboard had run - so anywhere the clock does not
                   tick, a lit chip is near-black text on a near-black panel and
                   the label simply is not there. Measured in the off-screen
                   render, where nothing animates: fill at Opacity 0, TextBlock
                   at #FF0C0C0C, chip blank.

                   From="0" on the enter animation is what lets both be true at
                   once: the Setter owns the resting state, so the chip is legible
                   with no clock at all, and the animation still starts from
                   transparent so the fade is not flattened out of existence. -->
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextHigh}"/>
                <Setter TargetName="fill" Property="Opacity" Value="1"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.13"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== TEXT BOXES ================== -->
    <Style x:Key="Search" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
      <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextMax}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource TextMid}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{StaticResource Field}" BorderBrush="{StaticResource Hairline}"
                    BorderThickness="1" CornerRadius="7">
              <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,0" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextMid}"/>
                <Setter TargetName="b" Property="Background" Value="{StaticResource Raised}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== THE TWO DROPDOWNS ==================
         PROJECT and LANE have too many values to be chips, so they are the only
         dropdowns on the screen. Templated from scratch: the stock ComboBox is
         drawn by the OS theme and would arrive light-grey and rounded in a way
         nothing else here is. -->
    <Style x:Key="DropItem" TargetType="ComboBoxItem">
      <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource BtnHover}"/>
                <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Raised}"/>
                <Setter Property="Foreground" Value="{StaticResource TextMax}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Drop" TargetType="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource FontText}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource TextMid}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="25"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource DropItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="tg" Focusable="False" ClickMode="Press" Cursor="Hand"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                      <Border x:Name="bb" Background="{StaticResource Field}" BorderBrush="{StaticResource Hairline}"
                              BorderThickness="1" CornerRadius="6"/>
                      <Path x:Name="ar" Data="M 0,0 L 4.5,4.5 L 9,0" Width="9" Height="5"
                            Stroke="{StaticResource TextDim}" StrokeThickness="1.4"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bb" Property="BorderBrush" Value="{StaticResource HairlineHi}"/>
                        <Setter TargetName="ar" Property="Stroke" Value="{StaticResource TextHigh}"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="bb" Property="BorderBrush" Value="{StaticResource TextMid}"/>
                        <Setter TargetName="bb" Property="Background" Value="{StaticResource Raised}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="cp" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="11,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     PopupAnimation="Fade" VerticalOffset="3">
                <Border Background="{StaticResource PanelHi}" BorderBrush="{StaticResource HairlineHi}"
                        BorderThickness="1" CornerRadius="7"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="360">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="2,5,2,5">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================== LIST ROWS ==================
         Selection is a lifted surface plus a solid white left bar - surface and
         value, since a tint is not available. Both layers are always present and
         merely transparent, so they can be CROSSFADED rather than switched, and
         so nothing shifts sideways when a row becomes selected. -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Rectangle x:Name="hover" Fill="{StaticResource RowHover}" Opacity="0"/>
              <Rectangle x:Name="sel"   Fill="{StaticResource Raised}"   Opacity="0"/>
              <Rectangle x:Name="bar"   Fill="{StaticResource TextMax}" Width="2"
                         HorizontalAlignment="Left" Opacity="0"/>
              <ContentPresenter/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.11"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                      <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20"/>
                      <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One template for all three row kinds. What differs between a project, a
         lane and a conversation is carried by the view model (brush, weight,
         indent, strikethrough, which cells are visible), not by three
         near-identical copies. -->
    <!-- == ONE CONVERSATION, ONE ROW ==
         This was a project / lane / conversation TREE. It is a flat table now,
         and the reason is the sort: a hierarchy cannot answer "the ten youngest
         across every project" at all, however it is ordered, and every column
         here is meant to be clickable. Project and lane became COLUMNS, which
         also removed 52 header rows - 195 rows for 143 conversations, and
         eleven of the fifteen projects had exactly one lane, called "main".

         Six columns became five. ID is gone from the row: eight hex characters
         nobody types, carried in the name's tooltip and the footer instead.
         OPEN? and DOING have merged, because "LIVE" and "working" were one fact
         said twice in two columns; they keep their separate marks inside the one
         column, so the two questions are still told apart. -->
    <DataTemplate x:Key="RowTemplate">
      <Grid Height="{Binding RowHeight}" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="54"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="*" MinWidth="240"/>
          <ColumnDefinition Width="196"/>
          <ColumnDefinition Width="212"/>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>

        <!-- 0: THE TICK. Reopens at logon. Never launches.
             ONLY ON CONVERSATIONS now. It used to sit on project and lane rows
             as well, so a fifteen-project list carried some fifty checkboxes of
             which only a third were about a conversation - "we always have to
             tick all boxes on the left". Shift-click ticks a range instead. -->
        <CheckBox Grid.Column="0" Style="{StaticResource TickBox}" Tag="tick"
                  Visibility="{Binding TickVisibility}"
                  IsChecked="{Binding Ticked, Mode=TwoWay}"
                  ToolTip="{Binding TickTip}"/>

        <!-- 1: the rule that fences the tick off from everything else. Rows are
             flush, so these stack into one continuous vertical line. -->
        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource HairlineHi}"
                   HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- 2: pinned marker, ON HOVER ONLY.
             128 of 143 conversations are pinned, because touching one pins it.
             A mark that is on nine rows in ten is texture, not information - it
             cost a column and told you nothing. The state is still reachable
             three ways: the pinned / not pinned chips, the footer's Unpin, and
             Bulk. What is gone is printing it on every row.
             A drawn asterisk, not the character: six strokes through one centre,
             which cannot be confused with the chevron or the bars beside it. -->
        <Grid Grid.Column="2" Style="{StaticResource RowActions}">
          <Button Style="{StaticResource BtnBare}" Tag="unpin"
                  Width="18" Height="20"
                  Visibility="{Binding PinVisibility}"
                  ToolTip="Pinned - the hourly roll leaves this alone. Click to hand it back.">
            <Path Data="M 4,0 L 4,8 M 0.5,2 L 7.5,6 M 0.5,6 L 7.5,2"
                  Width="8" Height="8" Stretch="None"
                  Stroke="{Binding PinBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </Grid>

        <!-- 3: name, and what an untitled conversation was about.
             A struck-through name is a conversation whose transcript is gone and
             that can never open. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="{Binding Indent}">
          <!-- THE FOLD, on group rows only. ONE drawn chevron rotated, not two
               characters: folded and open are provably the same mark at two
               angles, and no font substitution can take them apart. It sits
               inside the indented panel rather than in a fixed gutter, so a
               lane's chevron lines up under its project's. -->
          <Button Style="{StaticResource BtnBare}" Tag="fold"
                  Width="16" Height="16" Margin="0,0,3,0"
                  Visibility="{Binding FoldVisibility}"
                  ToolTip="Fold this group away. Searching and filtering ignore folds, so nothing you looked for can be hidden by one.">
            <Path Data="M 0,0 L 4,4 L 0,8" Width="8" Height="8" Stretch="None"
                  Stroke="{StaticResource TextMid}" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform>
                <RotateTransform Angle="{Binding FoldAngle}"/>
              </Path.RenderTransform>
            </Path>
          </Button>


          <Grid Width="13">
            <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                     Fill="{StaticResource TextMax}" Visibility="{Binding MovedVisibility}"
                     ToolTip="It has said something since you last opened it."/>
          </Grid>
          <TextBlock Text="{Binding Name}"
                     Foreground="{Binding NameBrush}"
                     FontWeight="{Binding NameWeight}"
                     FontSize="{Binding NameSize}"
                     TextDecorations="{Binding NameDecorations}"
                     ToolTip="{Binding NameTip}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Note}" Margin="12,0,0,0" FontSize="11.5"
                     FontFamily="{StaticResource FontSmall}"
                     Foreground="{Binding NoteBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Subtitle}" Visibility="{Binding SubtitleVisibility}"
                     Margin="10,0,0,0" FontSize="11.5"
                     FontFamily="{StaticResource FontSmall}"
                     Foreground="{StaticResource TextDim}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        <!-- WHAT THE GROUP HOLDS, and whether any of it will actually fire.
               A header that showed "12" and stayed silent about the project
               being switched off would repeat the morning that cost the operator
               every AlgoTrader lane: 89 ticks under a disabled project, and not
               a row on the screen saying so. -->
          <TextBlock Text="{Binding Counts}"
                     Visibility="{Binding CountsVisibility}"
                     Foreground="{Binding CountsBrush}"
                     FontSize="10.5" Margin="10,1,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 4: PROJECT / LANE. Was two levels of hierarchy; one column says the
             same thing on every row without spending a row to say it. -->
        <TextBlock Grid.Column="4" Text="{Binding Project}" Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource FontSmall}" FontSize="11.5"
                   Foreground="{StaticResource TextDim}"
                   TextTrimming="CharacterEllipsis"/>

        <!-- 5: STATE - two questions in one column, still told apart.
             LEFT of the middot: is anyone HOLDING it. A filled dot and bold LIVE
             is a process carrying the id; a hollow dot and lower-case live is
             inferred from a transcript that just moved; a drawn X and GONE is a
             transcript off disk for good. Mono type.
             RIGHT of it: what that process is DOING, in proportional type, lower
             case, with its own stroke glyphs. Nothing on the left is a stroke
             figure and nothing on the right is round, so the halves cannot be
             read as one another even sharing a column. -->
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                   Fill="{Binding DotFill}" Stroke="{Binding DotStroke}" StrokeThickness="1.2"
                   Visibility="{Binding DotVisibility}"/>
          <Path Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                Data="M 0,0 L 8,8 M 8,0 L 0,8"
                Stroke="{StaticResource TextMid}" StrokeThickness="1.5"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Visibility="{Binding GoneMarkVisibility}"/>
          <TextBlock Text="{Binding State}" VerticalAlignment="Center"
                     FontFamily="{StaticResource FontMono}" FontSize="11.5"
                     FontWeight="{Binding StateWeight}"
                     Foreground="{Binding StateBrush}"
                     TextDecorations="{Binding StateDecorations}"
                     ToolTip="{Binding StateTip}"/>
          <TextBlock Text="&#183;" Margin="8,0,8,0" VerticalAlignment="Center"
                     FontSize="11.5" Foreground="{StaticResource Hairline}"
                     Visibility="{Binding ConvGlyphVisibility}"/>
          <Path Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center"
                Stretch="None" Data="{Binding ConvGeometry}"
                Stroke="{Binding ConvBrush}" StrokeThickness="1.4"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Visibility="{Binding ConvGlyphVisibility}"/>
          <TextBlock Text="{Binding Conv}" VerticalAlignment="Center"
                     FontFamily="{StaticResource FontText}" FontSize="12"
                     FontWeight="{Binding ConvWeight}"
                     Foreground="{Binding ConvBrush}"
                     ToolTip="{Binding ConvTip}"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- 6: WHEN -->
        <TextBlock Grid.Column="6" Text="{Binding Age}" Margin="0,0,12,0"
                   HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontFamily="{StaticResource FontMono}"
                   FontSize="11.5" Foreground="{Binding AgeBrush}"/>

        <!-- 7: the rule that fences the actions off from everything else -->
        <Rectangle Grid.Column="7" Width="1" Fill="{StaticResource HairlineHi}"
                   HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- 8: actions. Opens it this second, tick or no tick. On the row you
             are pointing at, and on the selected one. -->
        <Grid Grid.Column="8" Style="{StaticResource RowActions}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <Button Style="{StaticResource BtnRow}" Tag="launch"
                  Visibility="{Binding ActionVisibility}"
                  Content="{Binding LaunchLabel}"
                  IsEnabled="{Binding CanLaunch}"
                  ToolTip="{Binding LaunchTip}"/>
          <Button Style="{StaticResource BtnRowQuiet}" Tag="spawn" Content="+"
                  Visibility="{Binding ActionVisibility}"
                  Margin="7,0,0,0"
                  ToolTip="Spawn a brand-new named session in this row's directory"/>
          <!-- The one row that is not a conversation: what the age window left
               out. Nothing is ever hidden silently, so the count that was cut
               is on screen and one click brings it back. -->
        </StackPanel>
        </Grid>
        <!-- OUTSIDE the hover style: the age window's own row is the one thing
             on the list that must be visible without being pointed at, or the
             58 conversations it is hiding stay hidden. -->
        <Button Grid.Column="8" Style="{StaticResource BtnRow}" Tag="more"
                Visibility="{Binding MoreVisibility}"
                Content="{Binding MoreLabel}"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                ToolTip="{Binding MoreTip}"/>
      </Grid>
    </DataTemplate>

    <!-- == THE INBOX ROW ==
         A SEPARATE template from RowTemplate above, and a separate list, on
         purpose. The tree row answers "what is in this project and does it
         reopen at logon"; the inbox row answers "who needs me and what did they
         last say". Those want different columns, and forcing one template to do
         both would mean eleven columns of which half are collapsed on every row.

         Two row kinds share this template, told apart by which cells are
         visible rather than by two near-identical copies:

           band       a heading with a count. NEEDS YOU / WORKING / IDLE.
           session    a conversation: state glyph, name, project, what it last
                      said, and how long ago.

         The BODY of the row is what it last said. That is the column that gets
         the remaining width, because it is the thing you came to read. -->
    <DataTemplate x:Key="InboxTemplate">
      <Grid Height="{Binding RowHeight}" Background="Transparent" Margin="{Binding Indent}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="Auto" MinWidth="120"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="120"/>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 0: the state mark. Same drawn geometry vocabulary as the tree view,
             so a chevron means "waiting for you" in both places. -->
        <Path Grid.Column="0" Data="{Binding ConvGeometry}"
              Visibility="{Binding ConvGlyphVisibility}"
              Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
              Stroke="{Binding ConvBrush}" StrokeThickness="1.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>

        <!-- 1: the name, or the band heading. The MOVED mark sits in front of
             it: something has been said here since you last looked. It is the
             unread dot every mail client uses, and it is the answer to
             "clicking through the tabs to see if there has been any progress". -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="13">
          <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Fill="{StaticResource TextMax}" Visibility="{Binding MovedVisibility}"
                   ToolTip="It has said something since you last opened it."/>
        </Grid>
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                   Foreground="{Binding NameBrush}"
                   FontWeight="{Binding NameWeight}"
                   FontSize="{Binding NameSize}"
                   TextDecorations="{Binding NameDecorations}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding ConvTip}"/>
        </StackPanel>

        <!-- 2: which project this belongs to. A LABEL here, not a parent: the
             inbox is deliberately cross-project, so the project is one more
             attribute of the row rather than a node above it. -->
        <!-- 2b: the band's count, NEXT TO THE HEADING IT COUNTS. It used to sit
             in the column where a conversation's prose goes, which put "3" a
             third of the way across the window from "NEEDS YOU" and made it
             read as if 3 were the project. A band never has a project, so the
             two can never collide here. -->
        <TextBlock Grid.Column="2" Text="{Binding Counts}"
                   Visibility="{Binding CountsVisibility}"
                   VerticalAlignment="Center" Margin="10,0,0,0"
                   FontFamily="{StaticResource FontSmall}" FontSize="11"
                   Foreground="{Binding CountsBrush}"/>
        <TextBlock Grid.Column="2" Text="{Binding Project}"
                   Visibility="{Binding ProjectVisibility}"
                   VerticalAlignment="Center" Margin="12,0,0,0"
                   FontFamily="{StaticResource FontSmall}" FontSize="11"
                   Foreground="{StaticResource TextDim}"
                   TextTrimming="CharacterEllipsis"/>

        <!-- 3: what it last said. The point of the whole view. -->
        <TextBlock Grid.Column="3" Text="{Binding Said}"
                   Visibility="{Binding SaidVisibility}"
                   VerticalAlignment="Center" Margin="16,0,10,0"
                   FontSize="12" Foreground="{Binding SaidBrush}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding SaidTip}"/>

        <!-- 4: how long ago, right-aligned so the numbers form a column. -->
        <TextBlock Grid.Column="4" Text="{Binding Stamp}"
                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"
                   FontFamily="{StaticResource FontSmall}" FontSize="11"
                   Foreground="{Binding StampBrush}"/>

        <!-- 5: what you can do about it, on the row you are pointing at and on
             the selected one. Eleven identical "Go to" buttons in a column say
             the same word eleven times. -->
        <Grid Grid.Column="5" Style="{StaticResource RowActions}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="{Binding ActionVisibility}" Margin="0,0,10,0">
            <Button Style="{StaticResource BtnRow}" Tag="jump"
                    Content="{Binding JumpLabel}"
                    IsEnabled="{Binding CanJump}"
                    ToolTip="{Binding JumpTip}"/>
          </StackPanel>
        </Grid>
      </Grid>
    </DataTemplate>

  </Window.Resources>

  <!-- =========================================================== -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- == title + search == -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1">
      <Grid Margin="22,16,22,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Claude sessions" FontFamily="{StaticResource FontDisplay}"
                     FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextMax}"/>
          <TextBlock x:Name="SubTitle" Text="what each one last said, and which are waiting on you"
                     FontFamily="{StaticResource FontSmall}"
                     FontSize="11.5" Foreground="{StaticResource TextLow}" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Column="1" Margin="30,0,22,0" MaxWidth="680" HorizontalAlignment="Stretch">
          <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Height="38"/>
          <TextBlock Text="Find by title, id, worktree or project"
                     IsHitTestVisible="False" Margin="13,0,0,0" FontSize="13.5"
                     VerticalAlignment="Center" Foreground="{StaticResource TextDim}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button x:Name="ClearSearch" Style="{StaticResource BtnBare}"
                  Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,8,0"
                  ToolTip="Clear the text filter (Esc)">
            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Width="8" Height="8" Stretch="None"
                  Stroke="{StaticResource TextDim}" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="BusyText" Text="" Foreground="{StaticResource TextMid}" FontSize="12"
                     VerticalAlignment="Center" Margin="0,0,14,0"/>
          <Button x:Name="RescanBtn" Style="{StaticResource Btn}" Content="Rescan"
                  ToolTip="Re-read every transcript, re-check what is live and re-read what each conversation is doing."/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- == summary + honest warnings ==
         Each pill carries the same mark as the column it counts: a filled dot
         for live, a chevron for waiting, a filled square for ticked. -->
    <Border Grid.Row="1" Background="{StaticResource Ink}" Padding="22,12,22,12">
      <StackPanel>
        <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="220"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True">

          <!-- WHICH VIEW. First thing on the row because it is the first thing
               you need to know about what you are looking at. -->
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Hairline}"
                  BorderThickness="1" CornerRadius="7" Padding="3" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ModeInbox" Style="{StaticResource Seg}" Content="Inbox" IsChecked="True"
                           ToolTip="Every conversation across every project, ordered by what it needs from you."/>
              <!-- RESTORE WAS A THIRD SEGMENT AND RENDERED THE SAME 195 ROWS AS
                   PROJECTS, in the same order, with the same keys. Compared row
                   for row: identical. All that differed was a caption, a count
                   pill and three buttons. One of the three views was a duplicate
                   of another, which is most of why the tool read as having more
                   places than it has ideas. The tick column and the launch
                   button live in All now. -->
              <RadioButton x:Name="ModeAll" Style="{StaticResource Seg}" Content="All"
                           ToolTip="Every conversation on this machine as one sortable list, with the logon tick."/>
            </StackPanel>
          </Border>

          <Button x:Name="LivePill" Style="{StaticResource Pill}"
                  AutomationProperties.Name="live now"
                  ToolTip="Jump to the sessions that are running right now.">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="{StaticResource TextMax}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="LiveSummary" Text="live now" Foreground="{StaticResource TextHigh}" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button x:Name="WaitPill" Style="{StaticResource Pill}" Margin="9,0,0,0"
                  AutomationProperties.Name="waiting for you"
                  ToolTip="Jump to whatever has stopped and is waiting on you.">
            <StackPanel Orientation="Horizontal">
              <Path Data="M 1,0 L 5.5,4.5 L 1,9" Width="6.5" Height="9" Stretch="None"
                    Stroke="{StaticResource TextMax}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="WaitSummary" Text="waiting for you" Foreground="{StaticResource TextHigh}" FontSize="12"/>
            </StackPanel>
          </Button>
          <Button x:Name="TickPill" Style="{StaticResource Pill}" Margin="9,0,0,0"
                  AutomationProperties.Name="ticked to reopen at logon"
                  ToolTip="Show what is ticked to reopen at the next logon.">
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{StaticResource TextMax}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="TickSummary" Text="ticked to reopen at logon" Foreground="{StaticResource TextHigh}" FontSize="12"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="ProbeStamp" Text="" Foreground="{StaticResource TextLow}" FontSize="11.5"
                     FontFamily="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <!-- Everything that used to be its own toolbar row. The bulk tick
             actions are occasional and now live behind one button; what stays
             on screen is the thing you press often and the thing the whole
             window is built around. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Button x:Name="CastBtn" Style="{StaticResource Btn}" Content="Send to many" Margin="0,0,9,0"
                  ToolTip="One message, typed into several running sessions. You pick the recipients and they are named back to you before anything is sent."/>
          <Button x:Name="BulkBtn" Style="{StaticResource Btn}" Content="Bulk" Margin="0,0,9,0"
                  ToolTip="Tick all, tick none, unpin all, collapse or expand the tree.">
            <Button.ContextMenu>
              <ContextMenu>
                <!-- ON WHAT IS SHOWN, not on the whole registry. "Tick all"
                     used to reach every conversation in every project including
                     the ones filtered off screen, which is a promise nobody can
                     check by looking. Collapse/Expand are gone with the tree. -->
                <MenuItem x:Name="TickAll"     Header="Tick all shown"   ToolTip="Tick every conversation currently in the list, and pin them"/>
                <MenuItem x:Name="TickNone"    Header="Untick all shown" ToolTip="Untick every conversation currently in the list, and pin them so the hourly roll leaves them alone"/>
                <MenuItem x:Name="UnpinAll"    Header="Unpin all shown"  ToolTip="Hand every conversation in the list back to the rolling auto-tick"/>
                <Separator/>
                <MenuItem x:Name="SeenAll"     Header="Mark all shown seen" ToolTip="Clear the moved marks on everything in the list"/>
                <Separator/>
                <!-- HIDING IS NEVER A DELETION. The registry is the only record a
                     conversation has, so hiding sets a flag and this brings the
                     hidden rows back into both lists, marked, ready to be unhidden. -->
                <MenuItem x:Name="ShowHidden"  Header="Show hidden" IsCheckable="True" ToolTip="Bring hidden conversations back into the list so you can unhide them. Nothing is ever removed - hiding is a flag on the conversation."/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <CheckBox x:Name="WorktreeToggle" Style="{StaticResource TickBox}" Margin="0,0,8,0"
                    ToolTip="Show a lane for each git worktree. Writes includeWorktrees to the config and rescans."/>
          <TextBlock x:Name="WorktreeCaption" Text="worktrees" VerticalAlignment="Center" Foreground="{StaticResource TextMid}" FontSize="12.5" Margin="0,0,18,0"/>
          <TextBlock x:Name="NowCaption" Text="RIGHT NOW" Style="{StaticResource PoleCaption}" Margin="0,0,12,0"/>
          <Button x:Name="LaunchTicked" Style="{StaticResource BtnNow}" Content="Launch everything ticked"
                  ToolTip="Open every ticked conversation that is not already open, up to the maxSessions cap"/>
        </StackPanel>
        </Grid>
        <TextBlock x:Name="Unattributed" Text="" Foreground="{StaticResource TextMid}" FontSize="12"
                   Margin="1,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Grid.Row 2 is deliberately empty. The toolbar that lived here was
         folded into the summary row above; the RowDefinition stays because an
         Auto row with no content is zero pixels tall, and removing it would
         mean renumbering every Grid.Row below plus the overlays' RowSpan, which
         is a lot of risk to reclaim nothing. -->

    <!-- == THE FILTER BAR ==
         Every dimension this window shows, as chips, always visible. The rules,
         stated once here because they have to be predictable to be usable:
           AND across dimensions, OR within one. Nothing lit in a dimension means
           that dimension is not filtering at all.
         A lit chip is filled. The row of chips IS the readout of what is applied,
         which is why they are always on screen rather than behind a menu, and
         why the match count sits at the end of the same strip. -->
    <Border x:Name="FilterBar" Grid.Row="3"
            Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,1" Padding="22,9,22,9">
      <StackPanel x:Name="FilterChips">

        <!-- == THE PERMANENT LINE ==
             The four BANDS, and nothing else that needs explaining. These are
             the same four groups the inbox heads its list with and the same four
             the summary pills count, so a chip, a band heading and a pill can
             never again mean three different things.

             They were "waiting / working / summarising / idle / unknown", which
             came from Get-ConvBucket: the LAST KNOWN state of a transcript,
             ignoring whether anything is still running. Measured over the real
             registry: that made "waiting" select 110 of 143 conversations while
             the band called NEEDS YOU held 6. One word, two meanings, on one
             screen. Filtering on the band is what makes a chip's count and a
             band's count the same number by construction.

             They carry live counts, which is why they earn permanent space: the
             line answers "how much is waiting on me" before it is clicked. -->
        <Grid x:Name="FilterMain">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="40"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="SHOW" Style="{StaticResource GroupCaption}"/>
            <ToggleButton x:Name="FbNeeds" Style="{StaticResource Chip}" Tag="band:needs" Content="Needs you"
                          ToolTip="Stopped and waiting on you: a question, a permission dialog, or a blocked agent."/>
            <ToggleButton x:Name="FbWorking" Style="{StaticResource Chip}" Tag="band:working" Content="Working"
                          ToolTip="Busy right now. Nothing for you to do."/>
            <ToggleButton x:Name="FbIdle" Style="{StaticResource Chip}" Tag="band:idle" Content="Idle"
                          ToolTip="At its prompt with nothing pending. Yours to pick up."/>
            <ToggleButton x:Name="FbQuiet" Style="{StaticResource Chip}" Tag="band:quiet" Content="Not running"
                          ToolTip="No process is holding it. Ticking this widens the inbox to reach conversations it normally leaves out."/>
          </StackPanel>

          <Border Grid.Column="1" Width="1" Background="{StaticResource Hairline}" Margin="12,2,14,2"/>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="PROJECT" Style="{StaticResource GroupCaption}"/>
            <ComboBox x:Name="ProjectFilter" Style="{StaticResource Drop}" Width="196"/>
            <TextBlock Text="LANE" Style="{StaticResource GroupCaption}" Margin="14,0,8,0"/>
            <ComboBox x:Name="LaneFilter" Style="{StaticResource Drop}" Width="140"/>
          </StackPanel>

          <ToggleButton x:Name="MoreFilters" Grid.Column="3" Style="{StaticResource Chip}"
                        Content="More" Margin="14,0,0,0" VerticalAlignment="Center"
                        ToolTip="Open? / logon tick / age. The filters you reach for less often."/>

          <!-- WHAT IS APPLIED, as tokens you can take off one at a time. The
               chips above only cover one dimension; the text box and the two
               dropdowns filter invisibly, and an invisible filter reads as
               missing data. Every one of them shows up here with an x. -->
          <StackPanel x:Name="ActiveTokens" Grid.Column="4" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="16,0,10,0" ClipToBounds="True"/>

          <TextBlock x:Name="FilterCount" Grid.Column="5" Text="" VerticalAlignment="Center"
                     FontFamily="{StaticResource FontText}" FontSize="12"
                     Foreground="{StaticResource TextMid}"/>
          <Button x:Name="ClearFilters" Grid.Column="6" Style="{StaticResource Btn}" Content="Clear"
                  Margin="14,0,0,0" Padding="11,4" FontSize="11.5" VerticalAlignment="Center"
                  ToolTip="Drop every chip, both dropdowns and the text box in one go (Esc)"/>
        </Grid>

        <!-- == THE REST, behind More ==
             Still inside FilterChips, so the one container handler wires these
             exactly like the permanent ones. -->
        <StackPanel x:Name="FilterMore" Orientation="Horizontal" Margin="0,11,0,1" Visibility="Collapsed">
          <TextBlock Text="OPEN?" Style="{StaticResource GroupCaption}"/>
          <ToggleButton x:Name="FlLive" Style="{StaticResource Chip}" Tag="live:live" Content="live"
                        ToolTip="A process is holding it, certainly or inferred. LIVE or live in the OPEN? column."/>
          <ToggleButton x:Name="FlNot" Style="{StaticResource Chip}" Tag="live:notlive" Content="not live"
                        ToolTip="No evidence anything is holding it, which is not the same as closed."/>
          <ToggleButton x:Name="FlGone" Style="{StaticResource Chip}" Tag="live:gone" Content="gone"
                        ToolTip="Transcript deleted. Can never be launched."/>

          <Border Width="1" Background="{StaticResource Hairline}" Margin="10,2,16,2"/>

          <TextBlock Text="LOGON" Style="{StaticResource GroupCaption}"/>
          <ToggleButton x:Name="FtOn" Style="{StaticResource Chip}" Tag="tick:ticked" Content="ticked"
                        ToolTip="Reopens at the next logon."/>
          <ToggleButton x:Name="FtOff" Style="{StaticResource Chip}" Tag="tick:unticked" Content="not ticked"
                        ToolTip="Does not reopen at the next logon."/>
          <ToggleButton x:Name="FpPin" Style="{StaticResource Chip}" Tag="pin:pinned" Content="pinned"
                        Margin="10,0,5,0"
                        ToolTip="Held by hand, so the hourly roll leaves it alone. Measured: 128 of 143 conversations are pinned, so this alone barely narrows anything - it is the inverse that is worth reaching for."/>
          <ToggleButton x:Name="FpFree" Style="{StaticResource Chip}" Tag="pin:unpinned" Content="not pinned"
                        ToolTip="Still handed to the hourly auto-tick roll."/>

          <Border Width="1" Background="{StaticResource Hairline}" Margin="10,2,16,2"/>

          <TextBlock Text="AGE" Style="{StaticResource GroupCaption}"/>
          <ToggleButton x:Name="FaRecent" Style="{StaticResource Chip}" Tag="age:recent" Content="recent"
                        ToolTip="Touched inside the recencyDays window from the config."/>
          <ToggleButton x:Name="FaStale" Style="{StaticResource Chip}" Tag="age:stale" Content="stale"
                        ToolTip="Not touched inside the recencyDays window. These are the rows marked STALE."/>
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- == column headings. Widths and the rules mirror RowTemplate. == -->
    <!-- The tree's column captions. Hidden in the inbox, which has different
         columns and needs no captions at all: a name, a project, a sentence and
         a time need no headings, and the bands already label the groups. That
         is a whole row of chrome the list gets back. -->
    <!-- == column captions. Widths and the rules mirror RowTemplate. ==
         Hidden in the inbox, which has no columns and needs no captions: a name,
         a project, a sentence and a time need no headings, and the bands already
         label the groups. That is a whole row of chrome the inbox gets back. -->
    <!-- THE INBOX'S OWN HEADING ROW, so there is ONE sorting mechanic in the
         tool rather than a sortable table beside an unsortable list. Its columns
         mirror InboxTemplate.

         The BANDS are not a sort key and cannot be sorted away: they are what
         the inbox IS. A sort reorders WITHIN each band, which is why WHEN can be
         flipped here without NEEDS YOU stopping being first. -->
    <Border x:Name="InboxHead" Grid.Row="4" Visibility="Collapsed"
            Background="{StaticResource PanelHi}" BorderBrush="{StaticResource Hairline}"
            BorderThickness="0,0,0,1" Padding="22,9,22,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="Auto" MinWidth="120"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="120"/>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="1" Tag="name"    Style="{StaticResource SortCap}" Content="CONVERSATION"/>
        <Button Grid.Column="2" Tag="project" Style="{StaticResource SortCap}" Margin="12,0,0,0" Content="PROJECT"/>
        <TextBlock Grid.Column="3" Text="WHAT IT LAST SAID" Style="{StaticResource Caption}" Margin="14,0,0,0"/>
        <Button Grid.Column="4" Tag="when"    Style="{StaticResource SortCap}" HorizontalAlignment="Right" Margin="0,0,10,0" Content="WHEN"/>
      </Grid>
    </Border>

    <Border x:Name="ListHead" Grid.Row="4" Background="{StaticResource PanelHi}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1" Padding="0,9,0,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="54"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="*" MinWidth="240"/>
          <ColumnDefinition Width="196"/>
          <ColumnDefinition Width="212"/>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Tag="logon"   Style="{StaticResource SortCap}" HorizontalAlignment="Center" Content="LOGON"/>
        <Button Grid.Column="3" Tag="name"    Style="{StaticResource SortCap}" Content="CONVERSATION"/>
        <Button Grid.Column="4" Tag="project" Style="{StaticResource SortCap}" Content="PROJECT / LANE"/>
        <Button Grid.Column="5" Tag="state"   Style="{StaticResource SortCap}" Content="STATE"/>
        <Button Grid.Column="6" Tag="when"    Style="{StaticResource SortCap}" HorizontalAlignment="Right" Margin="0,0,12,0" Content="WHEN"/>
        <TextBlock Grid.Column="8" Text="RIGHT NOW" Style="{StaticResource PoleCaption}" Margin="10,0,0,0"/>
      </Grid>
    </Border>

    <!-- == the list ==
         ScrollUnit is Pixel, not Item: item scrolling jumps a whole row at a
         time, which is the "row-jump" the operator asked to be rid of. Pixel
         scrolling keeps virtualization; the wheel itself is eased from
         sessions-gui.ps1 on top of it. -->
    <Grid Grid.Row="5">
      <!-- LIST ON TOP, CONVERSATION UNDERNEATH.
           The reading pane used to sit in the SAME grid row as the list and
           replace it: opening a conversation took the list off screen, so you
           lost your place every time you looked at anything. "It is hard to
           remember where we are" was half about that.

           SplitRow and ReadRow are both 0 while the pane is closed, which is
           what makes a GridSplitter safe to leave in the tree - it has nothing
           to drag until there is something below it. -->
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*" MinHeight="90"/>
        <RowDefinition x:Name="SplitRow" Height="0"/>
        <RowDefinition x:Name="ReadRow" Height="0"/>
      </Grid.RowDefinitions>

      <GridSplitter x:Name="ReadSplit" Grid.Row="2" Height="5"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="{StaticResource Hairline}"
                    ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                    Visibility="Collapsed"
                    ToolTip="Drag to give the conversation more or less room"/>

      <!-- == NEEDS YOU ==
           Pinned above the list, not injected into it: the tree is a project /
           lane / conversation hierarchy and a flat band of conversations from
           several projects is not a node in it. Injecting rows would also have
           to survive folding, filtering and the keep-selection logic, for a
           strip that is only ever a handful of names.

           Collapsed unless something is actually waiting. A band that is always
           there saying "0 waiting" is furniture; one that appears only when it
           has something to say is a signal. -->
      <Border x:Name="NeedsBand" Grid.Row="0" Visibility="Collapsed"
              Background="{StaticResource Raised}"
              BorderBrush="{StaticResource HairlineHi}" BorderThickness="0,0,0,1"
              Padding="22,8,22,8">
        <StackPanel Orientation="Horizontal">
          <Path Width="9" Height="9" Stretch="None"
                Data="M 0,0 L 4.5,4.5 L 0,9"
                Stroke="{StaticResource TextMax}" StrokeThickness="1.6"
                VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="NeedsLabel" Text="" VerticalAlignment="Center"
                     Foreground="{StaticResource TextMax}" FontWeight="SemiBold"
                     FontSize="12.5" Margin="0,0,14,0"/>
          <ItemsControl x:Name="NeedsList" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- A button, because the point of the band is to get you to the
                     row. Tag carries the row key; the click handler selects and
                     scrolls to it. -->
                <Button Style="{StaticResource BtnBare}" Tag="{Binding Key}"
                        Content="{Binding Label}" ToolTip="{Binding Tip}"
                        Margin="0,0,8,0"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <ListBox x:Name="RowList" Grid.Row="1"
               Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextHigh}"
               ItemContainerStyle="{StaticResource RowItem}"
               ItemTemplate="{StaticResource RowTemplate}"
               SelectionMode="Single"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               VirtualizingPanel.ScrollUnit="Pixel"
               KeyboardNavigation.DirectionalNavigation="Contained">
        <ListBox.RenderTransform>
          <TranslateTransform x:Name="ListShift" Y="0"/>
        </ListBox.RenderTransform>
      </ListBox>

      <!-- The inbox is its OWN list occupying the same cell, shown instead of
           the tree rather than beside it. Two lists rather than one list with a
           template selector: the tree's rendering, folding, filtering and
           keep-selection all work today, and a shared control would put every
           one of them at risk for no gain. Only one is ever visible. -->
      <ListBox x:Name="InboxList" Grid.Row="1" Visibility="Collapsed"
               Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextHigh}"
               ItemContainerStyle="{StaticResource RowItem}"
               ItemTemplate="{StaticResource InboxTemplate}"
               SelectionMode="Single"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               VirtualizingPanel.ScrollUnit="Pixel"
               KeyboardNavigation.DirectionalNavigation="Contained"/>

      <!-- == READING ONE CONVERSATION ==
           Replaces the list rather than sitting beside it. At 1480px a side
           panel would leave neither the list nor the text enough width, and
           long prose in a narrow column is the thing this view exists to make
           readable.

           A FlowDocument, not a stack of TextBlocks: it gives real text flow,
           selection across blocks and copy for free, and every run's typography
           is set from the same palette the rest of the window uses. -->
      <Grid x:Name="ReadPane" Grid.Row="3" Visibility="Collapsed"
            Background="{StaticResource Ink}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1"
                Padding="22,10,22,10">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="ReadName" Text="" FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource TextMax}" VerticalAlignment="Center"/>
              <TextBlock x:Name="ReadWhat" Text="" FontSize="12" Margin="14,0,0,0"
                         Foreground="{StaticResource TextMid}" VerticalAlignment="Center"/>
              <!-- WHERE WE ARE, IN YOUR WORDS.
                   The transcript says what was said; it does not say why it
                   matters or what you meant to do next, and that is the thing
                   that is actually gone when you come back three days later.
                   Saved on the conversation, shown on its row, and it OUTRANKS
                   the machine-extracted last line there - a summary you wrote
                   is worth more than the tail of a transcript. -->
              <TextBlock Text="NOTE" Style="{StaticResource GroupCaption}" Margin="22,0,8,0"/>
              <TextBox x:Name="ReadNote" Style="{StaticResource Search}" Width="320"
                       MinHeight="26" VerticalContentAlignment="Center"
                       ToolTip="Where this one is up to, in your words. Saved as you type; shown on the row instead of what it last said."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="ReadRefresh" Content="Refresh" Style="{StaticResource Btn}" Margin="0,0,8,0"/>
              <Button x:Name="ReadOpen" Content="Open the terminal" Style="{StaticResource BtnNow}" Margin="0,0,8,0"/>
              <!-- "Back to the list" was true when this pane REPLACED the list.
                   The list is six inches above it now, so the button closes the
                   pane rather than going anywhere. -->
              <Button x:Name="ReadBack" Content="Close" Style="{StaticResource Btn}"
                      ToolTip="Give the room back to the list (Esc)"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- == REPLYING ==
             Typing here attaches to that session's console and writes the line
             into it, targeted by PID from claude's own agents list, never by
             window focus, so nothing depends on what is on top of the screen.

             Disabled unless the session is actually running, because there is
             no console to type into otherwise, and the reason is shown rather
             than the box just being dead. -->
        <FlowDocumentScrollViewer x:Name="ReadView" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="{StaticResource Ink}"
                                  Foreground="{StaticResource TextHigh}"
                                  IsToolBarVisible="False" Padding="0"/>

        <Border Grid.Row="2" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0"
                Padding="22,10,22,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SendNote" Grid.Row="0" Grid.ColumnSpan="2" Text=""
                       FontSize="11.5" FontFamily="{StaticResource FontSmall}"
                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                       Margin="0,0,0,7"/>

            <TextBox x:Name="SendBox" Grid.Row="1" Grid.Column="0"
                     Style="{StaticResource Search}"
                     MinHeight="34" MaxHeight="110"
                     AcceptsReturn="False" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     ToolTip="Types this into the running session and presses Enter. Ctrl+Enter sends."/>
            <Button x:Name="SendBtn" Grid.Row="1" Grid.Column="1" Content="Send"
                    Style="{StaticResource BtnNow}" Margin="10,0,0,0" MinWidth="92"
                    ToolTip="Write this line into the session's console (Ctrl+Enter)."/>
          </Grid>
        </Border>
      </Grid>

      <TextBlock x:Name="EmptyNote" Grid.Row="1" Text="" Visibility="Collapsed"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{StaticResource TextMid}" FontSize="13.5" TextWrapping="Wrap"
                 MaxWidth="620" TextAlignment="Center"/>
    </Grid>

    <!-- == what the selected row is, and what can be done to it == -->
    <Border Grid.Row="6" Background="{StaticResource Panel}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="22,11,22,11">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="SelName" Text="nothing selected" Foreground="{StaticResource TextHigh}" FontSize="13"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="SelPath" Text="" Foreground="{StaticResource TextLow}" FontSize="11.5" Margin="0,3,0,0"
                     FontFamily="{StaticResource FontMono}" TextTrimming="CharacterEllipsis"/>
          <!-- The last thing the operator typed into this conversation. It is the
               fastest way to recognise which of nine same-named sessions this is,
               and it comes free with the state read. -->
          <TextBlock x:Name="SelPrompt" Text="" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,3,0,0"
                     FontFamily="{StaticResource FontSmall}" TextTrimming="CharacterEllipsis"
                     Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Button x:Name="SelTick"  Style="{StaticResource BtnTick}" Content="Tick / untick" Margin="0,0,7,0"
                  ToolTip="Toggle the logon tick for the selected row - and pin it (Space)"/>
          <Button x:Name="SelUnpin" Style="{StaticResource Btn}" Content="Unpin" Margin="0,0,18,0"
                  ToolTip="Hand the selected row back to the rolling auto-tick (U)"/>
          <Border Width="1" Background="{StaticResource Hairline}" Margin="0,4,18,4"/>
          <Button x:Name="SelLaunch" Style="{StaticResource BtnNow}" Content="Open now" Margin="0,0,7,0"
                  ToolTip="Open the selected row now, tick or no tick (L)"/>
          <Button x:Name="SelSpawn" Style="{StaticResource BtnNow}" Content="New session here"
                  ToolTip="Spawn a brand-new named session in this row's directory (S)"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- == status, legend, save ==
         The legend spells out every mark, because in monochrome a mark that has
         to be guessed at is a mark that does not work. It is split in two
         because the marks answer two different questions, and running them
         together as one paragraph is exactly the confusion this window is built
         to avoid.

         FOLDED AWAY BY DEFAULT. It is three dense lines you read once and then
         never again, and it was taking a tenth of the window permanently to
         teach something already learned. The "?" brings it back, and the choice
         is remembered for the session. -->
    <Border Grid.Row="7" Background="{StaticResource Ink}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="22,11,22,13">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="" Foreground="{StaticResource TextMid}" FontSize="12.5" TextWrapping="Wrap"/>
          <StackPanel x:Name="LegendBox" Visibility="Collapsed" Margin="0,7,0,0">
          <TextBlock FontSize="11.5" Foreground="{StaticResource TextLow}" TextWrapping="Wrap" LineHeight="19"
                     FontFamily="{StaticResource FontSmall}">
            <Run Text="OPEN?" FontWeight="Bold" Foreground="{StaticResource TextDim}"/><Run Text="  is anyone holding it."/>
            <Run Text="  LIVE" FontWeight="Bold" Foreground="{StaticResource TextMax}" FontFamily="{StaticResource FontMono}"/><Run Text=" a claude.exe holds it, certain."/>
            <Run Text="  live" Foreground="{StaticResource TextLow}" FontFamily="{StaticResource FontMono}"/><Run Text=" its transcript just moved, inferred."/>
            <Run Text="  blank"/><Run Text=" no evidence, which is not the same as closed."/>
            <Run Text="  X GONE" FontWeight="Bold" Foreground="{StaticResource TextMid}" FontFamily="{StaticResource FontMono}"/><Run Text=" transcript deleted, name struck through, Open dead."/>
          </TextBlock>
          <TextBlock FontSize="11.5" Foreground="{StaticResource TextLow}" TextWrapping="Wrap" LineHeight="19"
                     FontFamily="{StaticResource FontSmall}" Margin="0,1,0,0">
            <Run Text="DOING" FontWeight="Bold" Foreground="{StaticResource TextDim}"/><Run Text="  what it is doing, which is a different question."/>
            <Run Text="  waiting" Foreground="{StaticResource TextMax}" FontWeight="SemiBold"/><Run Text=" at its prompt, wants you."/>
            <Run Text="  working" Foreground="{StaticResource TextHigh}"/><Run Text=" running a tool or owing you a reply."/>
            <Run Text="  summarising" Foreground="{StaticResource TextHigh}"/><Run Text=" compacting itself."/>
            <Run Text="  was ..." /><Run Text=" nothing has moved for minutes, so that is the LAST state, not a current one."/>
            <Run Text="  *" Foreground="{StaticResource TextHigh}"/><Run Text=" pinned, the roll leaves it alone."/>
            <Run Text="  THE ROLL" FontWeight="Bold" Foreground="{StaticResource TextDim}"/><Run Text="  an hourly scan ticks the newest few conversations in each lane, unless you have pinned them. The exact counts are autoTickPerDirectory and autoTickPerWorktree in session-restore.config.json."/>
          </TextBlock>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Button x:Name="LegendToggle" Style="{StaticResource Btn}" Content="?" Width="34" Margin="0,0,9,0"
                  ToolTip="What every mark on this screen means. Folded away because it is three lines you read once."/>
          <Button x:Name="CancelBtn" Style="{StaticResource Btn}" Content="Close" Margin="0,0,9,0"
                  ToolTip="Close the window. If any tick has been changed and not saved, it asks first."/>
          <Button x:Name="SaveBtn" Style="{StaticResource BtnPrimary}" Content="Save"
                  ToolTip="Write the ticks to sessions-registry.json. The window STAYS OPEN (Ctrl+S)."/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- == overlay: confirming a launch that opens more than one tab ==
         In the window rather than a Win32 MessageBox: this is the confirmation
         the operator meets most often, a native dialog arrives in the OS
         language while the rest of this is in English, and a system box over
         this page reads as a different application. The two rare save/discard
         prompts on the way out still use MessageBox, which is both the OS
         convention and the only way to get a blocking three-way answer while a
         window is closing. -->
    <Border x:Name="ConfirmOverlay" Grid.Row="0" Grid.RowSpan="8" Background="{StaticResource Scrim}" Visibility="Collapsed">
      <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource HairlineHi}" BorderThickness="1" CornerRadius="12"
              Width="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <ScaleTransform x:Name="CfScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <StackPanel>
          <TextBlock x:Name="CfTitle" Text="" FontFamily="{StaticResource FontDisplay}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMax}"/>
          <TextBlock x:Name="CfMessage" Text="" FontSize="13" Foreground="{StaticResource TextHigh}" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="20"/>
          <Border x:Name="CfNoteBox" Background="{StaticResource Panel}" BorderBrush="{StaticResource HairlineHi}" BorderThickness="1"
                  CornerRadius="7" Padding="13,10" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock x:Name="CfNote" Text="" Foreground="{StaticResource TextMid}" FontSize="12" TextWrapping="Wrap"/>
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CfCancel" Style="{StaticResource Btn}" Content="Not now" Margin="0,0,9,0"/>
            <Button x:Name="CfOk" Style="{StaticResource BtnPrimary}" Content="Open them"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- == modal overlay: one message, several sessions ==
         RECIPIENTS ARE CHOSEN HERE, not taken from the logon ticks. The tick
         means "reopen this at logon" and most ticked conversations are not
         running at all, so sending to "everything ticked" would be a different
         set from the one the words describe. Ticking a box in this overlay is
         the only way to become a recipient, and the confirmation names every
         one of them before anything is typed anywhere. -->
    <Border x:Name="CastOverlay" Grid.Row="0" Grid.RowSpan="8" Background="{StaticResource Scrim}" Visibility="Collapsed">
      <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource HairlineHi}" BorderThickness="1" CornerRadius="12"
              Width="700" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Send to several sessions" FontFamily="{StaticResource FontDisplay}"
                     FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMax}"/>
          <TextBlock x:Name="CastLead" Grid.Row="1" Text="" FontSize="12" Foreground="{StaticResource TextMid}"
                     Margin="0,6,0,0" TextWrapping="Wrap"/>

          <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Hairline}"
                  BorderThickness="1" CornerRadius="8" Margin="0,16,0,0" MinHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,6">
              <StackPanel x:Name="CastList"/>
            </ScrollViewer>
          </Border>

          <TextBox x:Name="CastBox" Grid.Row="3" Style="{StaticResource Search}"
                   MinHeight="60" MaxHeight="140" Margin="0,14,0,0"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   ToolTip="Typed into every ticked session above, one at a time."/>

          <TextBlock x:Name="CastWho" Grid.Row="4" Text="" FontSize="11.5"
                     FontFamily="{StaticResource FontSmall}" Foreground="{StaticResource TextHigh}"
                     Margin="0,12,0,0" TextWrapping="Wrap"/>

          <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CastCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,9,0"/>
            <Button x:Name="CastSend" Style="{StaticResource BtnNow}" Content="Send" MinWidth="150" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- == modal overlay: naming a new session == -->
    <Border x:Name="Overlay" Grid.Row="0" Grid.RowSpan="8" Background="{StaticResource Scrim}" Visibility="Collapsed">
      <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource HairlineHi}" BorderThickness="1" CornerRadius="12"
              Width="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <ScaleTransform x:Name="OvScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <StackPanel>
          <TextBlock x:Name="OvTitle" Text="New session" FontFamily="{StaticResource FontDisplay}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMax}"/>
          <TextBlock x:Name="OvPath" Text="" FontSize="11.5" Foreground="{StaticResource TextLow}" Margin="0,6,0,0"
                     FontFamily="{StaticResource FontMono}" TextWrapping="Wrap"/>
          <!-- With no hue to spend, the warning is carried by a heavy left bar,
               the brightest text on the card and semibold weight. -->
          <Border x:Name="OvWarnBox" Background="{StaticResource Panel}" BorderBrush="{StaticResource TextMax}" BorderThickness="3,0,0,0"
                  Padding="14,10" Margin="0,16,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="OvWarn" Text="" Foreground="{StaticResource TextMax}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="They share this tree's git index. Commit with:  git commit -m msg -- &lt;paths&gt;"
                         Foreground="{StaticResource TextMid}" FontSize="11.5" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock Text="Name it, or leave it blank for an automatic one"
                     Foreground="{StaticResource TextMid}" FontSize="12.5" Margin="0,18,0,7"/>
          <TextBox x:Name="OvName" Style="{StaticResource Search}" Height="38"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OvCancel" Style="{StaticResource Btn}" Content="Cancel" Margin="0,0,9,0"/>
            <Button x:Name="OvOk" Style="{StaticResource BtnPrimary}" Content="Spawn it"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

  </Grid>
</Window>
